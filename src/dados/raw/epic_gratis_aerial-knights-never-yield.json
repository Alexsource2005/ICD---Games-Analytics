                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2021 Headup GmbH, all rights reserved. © 2021 Aerial_Knight",
                    "privacyPolicyLink": {
                        "src": "https://www.headupgames.com/imprint.php",
