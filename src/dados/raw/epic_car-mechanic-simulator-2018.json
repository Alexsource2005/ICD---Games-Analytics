                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Car Mechanic Simulator 2018© 2021 Playway. Developed by Red Dot Games. All other trademarks, logos and copyrights are property of their respective owners. All rights reserved.",
                    "privacyPolicyLink": {
                        "src": "https://www.playway.com/category-table",
                        "_type": "Diesel Link",
