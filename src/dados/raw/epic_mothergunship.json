                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2021 Terrible Posture Games. Versus Evil ® and the Versus Evil ® logo are trademarks, service marks, or registered trademarks or service marks of Versus Evil LLC. All other works, trademarks, and service marks appearing in this work are the property of their respective owners.",
                    "privacyPolicyLink": {
