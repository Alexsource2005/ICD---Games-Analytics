                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Automachef. Developed by Rhombico Games © 2019. Published by Team17 Digital Ltd. Team17 is a trademark or registered trademark of Team17 Digital Limited. All other trademarks, copyrights and logos are property of their respective owners.",
                    "privacyPolicyLink": {
                        "src": "https://www.team17.com/privacy-policy/",
