                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "©2020 Thunder Lotus. Todos os direitos reservados. Sundered e Thunder Lotus são marcas registradas da Thunder Lotus nos EUA e em outros países.",
                    "privacyPolicyLink": {
                        "src": "https://thunderlotusgames.com/privacy-policy/",
                        "_type": "Diesel Link",
                        "title": "Política de Privacidade da Thunder Lotus"
                    }
