                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Wilmot's Warehouse® © Hollow Ponds and Richard Hogg. All rights reserved.",
                    "privacyPolicyLink": {
                        "src": "https://finji.co/games/wilmotswarehouse/",
                        "_type": "Diesel Link",
