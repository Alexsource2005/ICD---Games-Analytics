                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Read Only Memories, MidBoss are registered trademarks of MidBoss, LLC. Ⓒ 2021 MidBoss, LLC. All Rights Reserved.",
                    "privacyPolicyLink": {
