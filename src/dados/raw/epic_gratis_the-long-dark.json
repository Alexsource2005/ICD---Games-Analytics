                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "THE LONG DARK ©2012-2025 Hinterland Studio Inc. \"THE LONG DARK\", \"WINTERMUTE\", \"Hinterland\" and the H logo are registered trademarks or trademarks of Hinterland Studio Inc. All rights reserved.",
                    "privacyPolicyLink": {
