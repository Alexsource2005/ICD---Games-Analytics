                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "©2020 Thunder Lotus. All Rights Reserved. Spiritfarer and Thunder Lotus are trademarks of Thunder Lotus in the U.S. and in other countries.",
                    "privacyPolicyLink": {
