                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© Two Point Studios 2021. Published by SEGA Publishing Europe Limited. Two Point, Two Point Hospital, the Two Point Hospital logo and Two Point Studios are either registered trade marks or trade marks of Two Point Studios Limited. SEGA and the SEGA logo are either registered trade marks or trade marks of SEGA Holdings Co., Ltd. or its affiliates. ",
                    "privacyPolicyLink": {
                        "src": "https://privacy.sega.com/en/sega-europe-limited-privacy-policy",
