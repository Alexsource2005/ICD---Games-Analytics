                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Obduction © Copyright 2016 / 2017 by Cyan, Inc. All rights reserved. Obduction and Cyan are registered trademarks of Cyan, Inc.",
                    "privacyPolicyLink": {
