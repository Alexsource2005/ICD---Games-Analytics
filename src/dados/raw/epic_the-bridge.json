                "about": {
                    "image": {
                        "src": "https://cdn2.unrealengine.com/Diesel%2Fproductv2%2Fthe-bridge%2Fhome%2FEGS_TheQuantumAstrophysicistsGuild_TheBridge_S4-510x680-3907ea70be9c2765eeebbd3492efe7446062fb80.jpg",
                        "_type": "Diesel Image"
