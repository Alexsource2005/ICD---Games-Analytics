                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© Stardock Entertainment. Galactic Civilizations is a registered trademark of Stardock Entertainment. All rights reserved.",
                    "privacyPolicyLink": {
                        "src": "https://www.stardock.com/policies/privacy",
                        "_type": "Diesel Link",
