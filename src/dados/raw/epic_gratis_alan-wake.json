                        "src": "https://cdn2.unrealengine.com/Diesel%2Fproduct%2Falan-wake%2Fhome%2FRemedy_logo_white-2000x1343-9039c890f1d521e6e300ed8980875bd692783b3f.png",
                        "_type": "Diesel Image"
