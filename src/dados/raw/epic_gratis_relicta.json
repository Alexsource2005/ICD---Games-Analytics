                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Copyright © Mighty Polygon 2016 - 2018. All Rights Reserved. Relicta and Mighty Polygon logos are trademarks or registered trademarks of Mighty Polygon S.L in Spain and elsewhere. Published by Ravenscourt , a division of Plaion GmbH (Austria). Ravenscourt and its respective logos are trademarks of Plaion GmbH. All other trademarks, logos and copyrights are owned by their respective owner. All rights reserved.",
                    "privacyPolicyLink": {
