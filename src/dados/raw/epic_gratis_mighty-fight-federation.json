                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Mighty Fight Federation and the Mighty Fight Logo are registered trademarks of Komi Games Inc. Copyright © 2021 Komi Games Inc. All rights reserved.",
                    "privacyPolicyLink": {
                        "src": "https://www.fightmighty.com/privacy.html",
