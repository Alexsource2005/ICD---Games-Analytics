                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Outlast, Outlast: Whistleblower & Outlast 2 © 2017 Red Barrels Inc. Developed by Red Barrels, Inc. Outlast and all characters, their distinctive likenesses, and related elements are trademarks and material protected by copyright of Red Barrels Inc.© 2017. All Rights Reserved.",
                    "privacyPolicyLink": {
