                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "©2019 Thunder Lotus. Todos os direitos reservados. Jotun e Thunder Lotus são marcas registradas da Thunder Lotus nos EUA e em outros países.",
                    "privacyPolicyLink": {
