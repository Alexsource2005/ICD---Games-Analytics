                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "©2021 and published by Plaion GmbH, Austria. Deep Silver, Gods Will Fall™ and their respective logos are trademarks of Plaion GmbH. Developed by Clever Beans Ltd. All other trademarks, logos and copyrights are property of their respective owners. All rights reserved.",
                    "privacyPolicyLink": {
