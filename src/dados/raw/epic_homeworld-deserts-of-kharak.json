                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2016-2025 Gearbox. Homeworld, Gearbox, and related logos are trademarks of Gearbox. All rights reserved. Additional storage may be required for set-up and updates. Internet connection and platform account required. Online and certain special features may not be available to all users or at all times.",
                    "privacyPolicyLink": {
