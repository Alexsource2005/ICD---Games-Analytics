                "about": {
                    "image": {
                        "src": "https://cdn2.unrealengine.com/egs-darkestdungeontheancestraledition-redhookstudios-bundles-s2-1200x1600-36be08f99ebb.jpg",
                        "_type": "Diesel Image"
