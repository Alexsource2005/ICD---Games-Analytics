            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows®XP SP3, Windows Vista/7/8 with latest service packs and updates installed<br></li><li><strong>Processador:</strong> Intel Core 2 Duo or equivalent AMD dual core CPU<br></li><li><strong>Memória:</strong> 2 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce 7600GS or ATI Radeon 1950, 256 Mb RAM<br></li><li><strong>DirectX:</strong> Versão 10<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 10 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Windows XP and DirectX® 9.0b and below not supported</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows XP/Vista/7/8<br></li><li><strong>Processador:</strong> Intel i5, 4 x 2.6 GHz or AMD equivalent<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 480 or ATI Radeon HD 5850 or better, 1Gb RAM<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 10 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Windows XP and DirectX® 9.0b and below not supported</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> 10.9.5<br></li><li><strong>Processador:</strong> 1.8 GHz<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> 256MB VRAM*<br></li><li><strong>Espaço no disco:</strong> Requer 6 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> The following graphics cards are not supported: ATI X1xxx series, ATI HD2xxx series, Intel GMA series, Intel HD3000, NVIDIA 7xxx series, NVIDIA 8xxx series, NVIDIA 9400 and NVIDIA 320M.  This game is not currently supported on volumes formatted as Mac OS Extended (Case Sensitive).</li></ul>",
