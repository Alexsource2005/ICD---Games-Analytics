                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Void Bastards is a production by Blue Manchu & Humble Bundle. © 2021. Humble Bundle and the Humble Bundle logo are trademarks and/or registered trademarks of Humble Bundle, Inc. throughout the world. All rights reserved.",
                    "privacyPolicyLink": {
                        "src": "https://www.humblebundle.com/privacy",
