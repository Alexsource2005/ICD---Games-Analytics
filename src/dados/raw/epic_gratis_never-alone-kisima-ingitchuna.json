                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "2014, 2016, 2021 Upper One Games, LLC, a wholly-owned subsidiary of E-Line Ventures, LLC",
                    "privacyPolicyLink": {
                        "src": "http://neveralonegame.com/privacy-policy/",
