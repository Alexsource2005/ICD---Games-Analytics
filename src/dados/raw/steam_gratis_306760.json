            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li>Requer um sistema operativo e processador de 64 bits<br></li><li><strong>Sistema Operativo *:</strong> Windows 7 SP1 64 bit or newer<br></li><li><strong>Processador:</strong> CPU Intel i5-2500 equivalent or better<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> GeForce 660 GTX w/1GB / AMD 7700 series w/1GB equivalent or better<br></li><li><strong>Espaço no disco:</strong> Requer 20 GB de espaço livre<br></li><li><strong>Compatibilidade com R.V.:</strong> SteamVR or Oculus PC<br></li><li><strong>Notas adicionais:</strong> For VR: NVIDIA 970 or AMD 480 (equivalent or greater)</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li>Requer um sistema operativo e processador de 64 bits<br></li><li><strong>Sistema Operativo:</strong> Windows 10 64 bit<br></li><li><strong>Processador:</strong> CPU Intel i5-4590 equivalent or better<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GTX 970 w/4 GB / AMD R9 290 w/4 GB equivalent or better<br></li><li><strong>Espaço no disco:</strong> Requer 20 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> For VR: NVIDIA 980/1060 or AMD Fury (equivalent or greater)</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Sierra 10.12.4<br></li><li><strong>Processador:</strong> Intel CPU capable of 4 or more threads<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Intel HD Graphics 4000, Iris 5000 &amp; 6000 family w/1 GB VRAM or better. Most Macs from 2012 on.<br></li><li><strong>Espaço no disco:</strong> Requer 20 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> MacOS 10.12.4 (or later) is required to play Obduction. Any MacOS versions prior to this may result in random crashes. Metal support is required to play Obduction.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Sierra 10.12.4<br></li><li><strong>Processador:</strong> Quad Core Intel<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> nVidia GT 600M, 700M family / AMD R9 M family or better<br></li><li><strong>Espaço no disco:</strong> Requer 20 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> MacOS 10.12.4 (or later) is required to play Obduction. Any MacOS versions prior to this may result in random crashes. Metal support is required to play Obduction.</li></ul>"
            },
