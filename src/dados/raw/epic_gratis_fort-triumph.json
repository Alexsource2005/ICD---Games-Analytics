                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Fort Triumph © 2017. Published by AIG. Developed by CookieByte Entertainment. All product names, trademarks and registered trademarks are property of their respective owners.",
                    "privacyPolicyLink": {
                        "src": "https://www.allingames.com/privacy-policy/",
