                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "'Circus Electrique is a trademark of Zen Studios Ltd. ©️ 2021 Zen Studios Ltd. All rights reserved.",
                    "privacyPolicyLink": {
