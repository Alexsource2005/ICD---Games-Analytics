                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2018 \"Mutant: Year Zero\" é uma marca registrada da Game Ark, LLC. Logotipos relacionados, personagens, nomes e semelhanças reconhecíveis são marcas comerciais ou marcas registradas da Game Ark, LLC. Funcom® e Bearded Ladies™ são usuários autorizados. © 2018 Funcom Oslo A/S. Todos os direitos reservados. Funcom® é uma marca registrada da Funcom Oslo A/S.",
                    "privacyPolicyLink": {
                        "src": "https://www.funcom.com/privacy-policy/",
                        "_type": "Diesel Link",
                        "title": "Política de Privacidade da Funcom"
                    }
