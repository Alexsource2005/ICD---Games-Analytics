                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2018 \"Mutant: Year Zero” is a registered trademark of Game Ark, LLC. Related logos, characters, names, and distinctive likenesses thereof are trademarks or registered trademarks of Game Ark, LLC. Funcom® and Bearded Ladies™ are authorized users. © 2018 Funcom Oslo A/S. All rights reserved. Funcom® is a registered trademark of Funcom Oslo A/S.",
                    "privacyPolicyLink": {
