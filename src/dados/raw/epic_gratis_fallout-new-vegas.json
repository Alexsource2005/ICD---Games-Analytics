                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2022 Bethesda Softworks LLC, a ZeniMax Media company. Fallout, Bethesda, Bethesda Softworks, Bethesda Game Studios, ZeniMax, Pip-Boy, Vault-Tec, and related logos are registered trademarks or trademarks of ZeniMax Media Inc. in the U.S. and/or other countries. All Rights Reserved.",
                    "privacyPolicyLink": {
                        "src": "https://bethesda.net/document/privacy-policy",
