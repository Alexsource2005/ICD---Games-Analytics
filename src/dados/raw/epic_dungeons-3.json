                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Dungeons 3 Copyright © 2017 Kalypso Media GmbH. Developed by Realmforge Studios. Published by Kalypso Media GmbH. All rights reserved. All other logos, copyrights and trademarks are property of their respective owner.",
                    "privacyPolicyLink": {
                        "src": "https://www.kalypsomedia.com/en/privacy-policy",
