                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2014-2022 The Astronauts. All other brands, product names and logos are trademarks or registered trademarks of their respective owners. All rights reserved.",
                    "privacyPolicyLink": {
