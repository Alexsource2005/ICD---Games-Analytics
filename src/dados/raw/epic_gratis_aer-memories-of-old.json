                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "© 2017 Daedalic Entertainment GmbH and Forgotten Key AB. Daedalic-logo is a trademark of Daedalic Entertainment GmbH, Germany. AER Memories of Old is a trademark of Forgotten Key AB, Sweden. Developed by Forgotten Key. All rights reserved.",
                    "privacyPolicyLink": {
