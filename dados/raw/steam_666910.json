                "reviews": [
                    {
                        "recommendationid": "230465121",
                        "author": {
                            "steamid": "76561198130342629",
                            "num_reviews": 34,
                            "playtime_forever": 444,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 443,
                            "deck_playtime_at_review": 381,
                            "last_played": 1790121797
                        },
                        "language": "english",
                        "review": "My son made this game, so this review is admittedly biased. He made this game when he was 15 years old. I got stuck a lot and he had to bail me out. He told me that Malfunction 2 is way better because he learned so much from making this one, but I wanted to play his first game first. I enjoyed it, I'm proud of him and I have no idea how he did this. The fact that he made and self published 4 games on Steam with no help or input from me (which as a dad who is always asked for help, so shocking). I'm very proud and will definitely move on to his \"better\" game, the sequel and his other games. I had not played his games because I wasn't able to as I was a console gamer. I recently got back into PC gaming. I played this on Steam Deck and it plays well enough, it was made before SD, so you might have to play around with the controls a bit but performance wise, it plays well.",
