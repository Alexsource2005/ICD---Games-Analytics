                        "recommendationid": "237747222",
                        "author": {
                            "steamid": "76561197987948166",
                            "num_reviews": 48,
                            "playtime_forever": 318,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 318,
                            "last_played": 1792024860
