                "reviews": [
                    {
                        "recommendationid": "49059402",
                        "author": {
                            "steamid": "76561198068967053",
                            "num_reviews": 199,
                            "playtime_forever": 10,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 10,
                            "last_played": 1550430772
