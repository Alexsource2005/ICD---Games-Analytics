                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Gone Home® é uma marca registrada da The Fullbright Company, LLC 2013. Todos os direitos reservados",
                    "privacyPolicyLink": {
                        "src": "https://fullbrig.ht/privacy",
