                "reviews": [
                    {
                        "recommendationid": "234393612",
                        "author": {
                            "steamid": "76561198118005728",
                            "num_reviews": 1003,
                            "playtime_forever": 749,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 749,
                            "last_played": 1517137339
                        },
                        "language": "english",
                        "review": "12 Labours of Hercules VII: Fleecing the Fleece is a casual resource/time management strategy game. At the start of each level, you have 1 or 2 workers who you direct to do various things ranging from collecting resources to constructing and upgrading buildings or gold mines. Hercules does the heavy work if there's a boulder in the way. Its as good as the first and overall it's a very enjoyable time management and if you're a fan of the genre you should pick it up.",
