                "reviews": [
                    {
                        "recommendationid": "50710641",
                        "author": {
                            "steamid": "76561198049701098",
                            "num_reviews": 832,
                            "playtime_forever": 35,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 35,
                            "last_played": 1558220902
