                "reviews": [
                    {
                        "recommendationid": "26468250",
                        "author": {
                            "steamid": "76561197986715648",
                            "num_reviews": 133,
                            "playtime_forever": 52,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 44,
                            "last_played": 1493793153
                        },
                        "language": "english",
                        "review": "I cannot recommend this game at this time. It has a bug when adding experience that causes the game to crash when adding experience from the match you just completed, which means you have to do the match over. You have to save after every fight to avoid it. The menus covering the screen instead of in a certain area just looks like bad format. The game might be fun if you can get passed the crashing. I did notify the dev and they replied, but have yet to see a difference. Also the forum is pretty dead, so the popularity for this game looks null.",
                        "timestamp_created": 1478485956,
                        "timestamp_updated": 1478485956,
                        "voted_up": false,
                        "votes_up": 12,
                        "votes_funny": 0,
                        "weighted_vote_score": 0.6233537197113037,
                        "comment_count": 1,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": true,
                        "developer_response": "This review is a bit outdated now.\n\nThe EXP bug you describe has now been taken care of in the most recent patch (February 20th, 2017). This bug was the most notorious which assuredly pushed away many players as it removed their ability to play the game. This is no longer the case and the game can be played without issue at this point in time. \n\nThank you for your review, I hope you take another look at the game in the future or change your mind about the review.",
                        "timestamp_dev_responded": 1487575174,
                        "primarily_steam_deck": false,
