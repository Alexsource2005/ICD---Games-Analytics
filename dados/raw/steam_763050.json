                "reviews": [
                    {
                        "recommendationid": "42122206",
                        "author": {
                            "steamid": "76561198009802063",
                            "num_reviews": 149,
                            "playtime_forever": 238,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 238,
                            "last_played": 1526926710
