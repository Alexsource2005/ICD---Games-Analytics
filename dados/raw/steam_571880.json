                "reviews": [
                    {
                        "recommendationid": "239771788",
                        "author": {
                            "steamid": "76561199061944724",
                            "num_reviews": 2,
                            "playtime_forever": 938,
                            "playtime_last_two_weeks": 938,
                            "playtime_at_review": 654,
                            "deck_playtime_at_review": 647,
                            "last_played": 1794263507
                        },
                        "language": "english",
                        "review": "This game is genuinely awesome. It’s actually so good, I removed 5 other visual novel “games” from my steam account, cause this game makes me embarrassed to own the others. It’s well written, the characters are all very fleshed out, and the art style is pretty. Unlike some other games I’ve played, there’s a real story where decisions actually matter. It is also NOT some ultra-nsfw focused game, which is very nice as well for something in this sub genre. I’d say if you don’t detest the fact that the characters are (mostly) all dragons, you should definitely give this game a try.",
