            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> x86 bit versions of Microsoft Windows XP (SP3),Windows Vista (SP2), Windows 7 and 8<br></li><li><strong>Processador:</strong> AMD/Intel dual-core processor running at 1.8 GHz (AMD Athlon X2 and Intel Core2Duo are the oldest CPU architectures recommended)<br></li><li><strong>Memória:</strong> 2048 MB de RAM<br></li><li><strong>Placa gráfica:</strong> ATI/nVidia dedicated/integrated or mobile graphic card, with at least 256MB of dedicated VRAM and Shader Model 3.0 support. Intel HD2000, ATI/AMD Radeon HD2400 and NVIDIA GeForce 7600GT and above<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Placa de som:</strong> DirectX 9 compatible soundcard<br></li><li><strong>Notas adicionais:</strong> Keyboard, mouse, Internet Connection</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> x86 bit versions of Microsoft Windows XP (SP3),Windows Vista (SP2), Windows 7 and 8<br></li><li><strong>Processador:</strong> AMD or Intel dual-core processor running at 2.4 GHz (Intel Core i3 1st gen or AMD Athlon II x2 or newer architectures are recommended)<br></li><li><strong>Memória:</strong> 2048 MB de RAM<br></li><li><strong>Placa gráfica:</strong> ATI/Nvidia dedicated/integrated or mobile graphic card with at least 512 of dedicated VRAM and Shader Model 4.0 support. Intel HD3000, ATI/AMD Radeon HD3800 series and NVIDIA GeForce 9600GT and above<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Placa de som:</strong> Integrated or dedicated DirectX 9 compatible soundcard<br></li><li><strong>Notas adicionais:</strong> Keyboard, mouse, Internet Connection</li></ul>"
