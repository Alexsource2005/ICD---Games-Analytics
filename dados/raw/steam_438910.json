                "reviews": [
                    {
                        "recommendationid": "25379336",
                        "author": {
                            "steamid": "76561197998897688",
                            "num_reviews": 1,
                            "playtime_forever": 91,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 63,
                            "last_played": 1531706378
