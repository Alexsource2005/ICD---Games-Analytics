                "reviews": [
                    {
                        "recommendationid": "28110785",
                        "author": {
                            "steamid": "76561198024985000",
                            "num_reviews": 267,
                            "playtime_forever": 766,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 761,
                            "last_played": 1769231477
