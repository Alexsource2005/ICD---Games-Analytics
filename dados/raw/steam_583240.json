                "reviews": [
                    {
                        "recommendationid": "32628660",
                        "author": {
                            "steamid": "76561197995686247",
                            "num_reviews": 31,
                            "playtime_forever": 71,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 26,
                            "last_played": 1535582145
                        },
                        "language": "english",
                        "review": "Having seen this game evolve from it's very inception, it's been very satisfying to see how it gets refined with every updates. To me, the gameplay feels like a strange mix of Smash Bros and Lethal League, which makes the game WAY more accessible than your average fighting game, plus the main mechanic is not something i've ever seen in another fighting game.\n\nThe game in its current state is by no means a complete package, but if you have a few friends who like indie brawlers, you'll have a lot of fun at parties. It is exactly the kind of product that greatly benefits from early access feedbacks.\n\nDisclaimer: The devs are former colleagues of mine and I received a copy of the game for free to provide early feedbacks and inputs.",
                        "timestamp_created": 1498083077,
                        "timestamp_updated": 1498083077,
                        "voted_up": true,
                        "votes_up": 33,
                        "votes_funny": 3,
                        "weighted_vote_score": 0.703866720199585,
                        "comment_count": 1,
