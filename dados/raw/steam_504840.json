                "reviews": [
                    {
                        "recommendationid": "24787925",
                        "author": {
                            "steamid": "76561197972875431",
                            "num_reviews": 23,
                            "playtime_forever": 119,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 65,
                            "last_played": 1642381133
