                "reviews": [
                    {
                        "recommendationid": "24215428",
                        "author": {
                            "steamid": "76561198028673669",
                            "num_reviews": 401,
                            "playtime_forever": 295,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 295,
                            "last_played": 1468093471
