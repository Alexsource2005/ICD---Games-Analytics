                "reviews": [
                    {
                        "recommendationid": "239464050",
                        "author": {
                            "steamid": "76561198068477002",
                            "num_reviews": 37,
                            "playtime_forever": 2154,
                            "playtime_last_two_weeks": 2129,
                            "playtime_at_review": 1978,
                            "last_played": 1793992394
