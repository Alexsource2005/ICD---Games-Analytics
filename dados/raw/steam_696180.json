                "reviews": [
                    {
                        "recommendationid": "238673814",
                        "author": {
                            "steamid": "76561198044442401",
                            "num_reviews": 117,
                            "playtime_forever": 2172,
                            "playtime_last_two_weeks": 325,
                            "playtime_at_review": 2172,
                            "last_played": 1793102823
                        },
                        "language": "english",
                        "review": "This game is a guilty pleasure of mine. It has a lot of jank and bugged phisics, but I don't know why, I just liked it really much. It is as simple as it gets with the gameplay. You shhot the enemy until it's dead, that is it. I turned off the music, because it gets old really quick, but because of this, (I think) some of the cutscenes are silent. I bought this for 3 euros, so I can't complain about the game being janky, plus I wanted to try this out for a long time. I liked it.",
