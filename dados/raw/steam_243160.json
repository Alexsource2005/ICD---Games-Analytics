=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/243160/extras/bfd2751a91b4edcdfd39a9be9d933f57.poster.avif?t=1572465769\" width=256 height=160 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/243160/extras/bfd2751a91b4edcdfd39a9be9d933f57.webm?t=1572465769\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/243160/extras/bfd2751a91b4edcdfd39a9be9d933f57.mp4?t=1572465769\" type=\"video/mp4\"></video></span>",
