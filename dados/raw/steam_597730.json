                "reviews": [
                    {
                        "recommendationid": "41330365",
                        "author": {
                            "steamid": "76561197999899413",
                            "num_reviews": 346,
                            "playtime_forever": 295,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 295,
                            "last_played": 1523067380
