                "reviews": [
                    {
                        "recommendationid": "39886818",
                        "author": {
                            "steamid": "76561197996899722",
                            "num_reviews": 330,
                            "playtime_forever": 34,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 34,
                            "last_played": 1517413586
