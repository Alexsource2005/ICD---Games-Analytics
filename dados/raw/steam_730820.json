                "reviews": [
                    {
                        "recommendationid": "237524780",
                        "author": {
                            "steamid": "76561198044328253",
                            "num_reviews": 5,
                            "playtime_forever": 531,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 531,
                            "last_played": 1664683000
                        },
                        "language": "english",
                        "review": "This game holds the most memories for me out of all of the Monkey Island games. I remember putting the CD-ROM into the tray and feeling transported to a witty, satirical pirate world. This is the third part of the Monkey Island series and the first to be non-pixel animated. I find myself returning back to this game to play every time over the other ones. It has all of the loveable characters you remember from the first two games (Guybrush, LeChuck, Elaine, Wally, etc) including an interesting continuation of the story and beautiful dialogue. The pirate insult fights are a highlight. I would recommend this game to anyone- LucasArts did an amazing job with this game.",
