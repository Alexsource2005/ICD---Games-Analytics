            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 - 64 bit<br></li><li><strong>Processador:</strong> Intel i7-4790 equivalent or greater<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 970 equivalent or greater<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Espaço no disco:</strong> Requer 3 GB de espaço livre<br></li><li><strong>Compatibilidade com R.V.:</strong> SteamVR. Room Scale 2m by 1.5m area required<br></li><li><strong>Notas adicionais:</strong> Requires a functional HTC Vive setup with 2 controllers, or an Oculus Rift platform with 2 Touch controllers</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Windows 10<br></li><li><strong>Processador:</strong> Intel i7-6800k equivalent or greater<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 1080 equivalent or greater<br></li><li><strong>DirectX:</strong> Versão 12<br></li><li><strong>Espaço no disco:</strong> Requer 3 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Requires a functional HTC Vive setup with 2 controllers, or an Oculus Rift platform with 2 Touch controllers</li></ul>"
