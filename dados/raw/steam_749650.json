                "reviews": [
                    {
                        "recommendationid": "36691618",
                        "author": {
                            "steamid": "76561198086542708",
                            "num_reviews": 106,
                            "playtime_forever": 25,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 25,
                            "last_played": 1511336993
