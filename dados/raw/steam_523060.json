            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 SP1 or greater<br></li><li><strong>Processador:</strong> Intel® i3-2310M equivalent or greater<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Intel® HD Graphics 3000 equivalent or greater<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Espaço no disco:</strong> Requer 100 MB de espaço livre<br></li><li><strong>Compatibilidade com R.V.:</strong> SteamVR<br></li><li><strong>Notas adicionais:</strong> Play on a two dimensional square grid with a low spec PC (above requirements are for a 5 year old laptop which can run Planet Smasher with no issues)</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 SP1 or greater<br></li><li><strong>Processador:</strong> Intel® i5-4590 / AMD FX 8350 equivalent or greater<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce® GTX 970 / AMD Radeon™ R9 290 equivalent or greater<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Espaço no disco:</strong> Requer 100 MB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Play on a three dimensional cubic grid in Virtual Reality (above requirements are the minimum recommended for the HTC Vive / Oculus Rift)</li></ul>"
