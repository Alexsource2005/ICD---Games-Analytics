            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Windows 10<br></li><li><strong>Processador:</strong> 3rd Gen i3/AMD FX-4100 Series<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Intel HD (Integrated), GeForce 6 Series/Radeon R7 Series<br></li><li><strong>Espaço no disco:</strong> Requer 3 GB de espaço livre<br></li><li><strong>Placa de som:</strong> One that allows sound to come out of a sound maker</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Windows 10<br></li><li><strong>Processador:</strong> 5th Gen i3/1st Gen Ryzen (or better)<br></li><li><strong>Memória:</strong> 4 MB de RAM<br></li><li><strong>Placa gráfica:</strong> GeForce 7 Series /Radeon R7 Series (or better)<br></li><li><strong>Espaço no disco:</strong> Requer 3 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> You can use the following controllers for this game; M/K, Xbox 360 Controller, Xbox One Controller, PS3/PS4 controllers, PS3/4 Rock Band Guitars, XB Rock Band Guitars, our Custom &quot;The Metronomicon&quot; Dance Pad, plus the majority of USB Dance Pads (sadly we haven't tested them all so there is no guarantee on these)</li></ul>"
            },
