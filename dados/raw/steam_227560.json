            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows XP (SP3), Windows Vista (SP2), Windows 7 and Windows 8<br></li><li><strong>Processador:</strong> Processor Intel Core 2 Duo, AMD Athlon X2, or equivalent, running at 1.86 GHz or greater<br></li><li><strong>Memória:</strong> 2 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Video Card DirectX 9.0c compatible, 256 MB of VRAM; NVIDIA GeForce 7900 GS, ATI Radeon HD 2600 Pro 256 MB, or greater<br></li><li><strong>DirectX:</strong> Versão 9.0<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 5 GB de espaço livre<br></li><li><strong>Placa de som:</strong> Soundcard DirectX 9.0c compatible, 16-bit</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Mac OS X Lion 10.7.5<br></li><li><strong>Processador:</strong> Intel Core 2 Duo Processor<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Nvidia 8800GT / AMD HD4870 / Intel Iris graphics card with at least 512 MB VRAM<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 5 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Keyboard / mouse or trackpad. Apple Magic Mouse and Trackpad users must remap the Aim control using in-game configuration, since those devices do not allow simultaneous left and right clicks.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Mac OS X Mavericks 10.9.2 or higher<br></li><li><strong>Processador:</strong> Intel Core i Series processor<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Nvidia 650M / AMD HD5750M with at least 1 GB VRAM<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 5 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Keyboard / 3-button Mouse. Apple Magic Mouse and Trackpad users must remap the Aim control using in-game configuration, since those devices do not allow simultaneous left and right clicks.</li></ul>"
            },
