                "reviews": [
                    {
                        "recommendationid": "42446832",
                        "author": {
                            "steamid": "76561198233944892",
                            "num_reviews": 71,
                            "playtime_forever": 358,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 358,
                            "last_played": 1527964691
