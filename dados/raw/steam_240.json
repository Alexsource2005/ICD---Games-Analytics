                "reviews": [
                    {
                        "recommendationid": "237884125",
                        "author": {
                            "steamid": "76561197960380837",
                            "num_reviews": 97,
                            "playtime_forever": 40232,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 40232,
                            "last_played": 1678555521
