                "reviews": [
                    {
                        "recommendationid": "51160412",
                        "author": {
                            "steamid": "76561198002461359",
                            "num_reviews": 34,
                            "playtime_forever": 712,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 406,
                            "last_played": 1560369650
