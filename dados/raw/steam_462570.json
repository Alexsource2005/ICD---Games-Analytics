                "reviews": [
                    {
                        "recommendationid": "64806247",
                        "author": {
                            "steamid": "76561198042831386",
                            "num_reviews": 627,
                            "playtime_forever": 329,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 329,
                            "last_played": 1567349890
