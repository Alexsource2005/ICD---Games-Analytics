                "reviews": [
                    {
                        "recommendationid": "37917820",
                        "author": {
                            "steamid": "76561198060293715",
                            "num_reviews": 23,
                            "playtime_forever": 13,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 13,
                            "last_played": 1511922812
                        },
                        "language": "english",
                        "review": "Upon purchase of this game, and I am assuming this applies to any game by this developer, the devs supply you with what is apparantly the demo version of the game; after so many games they want you to pay for it again to buy a license. Checked their site; these games have free trial versions you can download from them directly, so it's a really low blow trying to monetize the free trial. In essence they're trying to get you to pay for it twice.\n\nAvoid any games from this developer on Steam like the plague; I myself will never purchase another game of theirs via Steam ever again.\n\nGameplay wise, it's Bejeweled; if you liked Bejeweled, you'll probably like this.",
                        "timestamp_created": 1511924489,
                        "timestamp_updated": 1511924489,
                        "voted_up": false,
                        "votes_up": 15,
                        "votes_funny": 0,
                        "weighted_vote_score": 0.7098018527030945,
                        "comment_count": 0,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": false,
                        "developer_response": "Hi, and sorry for the trouble! Your Steam copy is the full game, so you should never need to pay again. At startup the game checks your license with Steam, and if that check can't reach Steam's servers it falls back to trial mode. Please make sure Steam is running and online, then restart the game. That fixes it in almost every case. If it still asks for a license, write to us at info@bakno.com and we'll sort it out right away. Andres, baKno Games",
                        "timestamp_dev_responded": 1790712099,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
