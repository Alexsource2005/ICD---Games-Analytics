                },
                "reviews": [
                    {
                        "recommendationid": "30816253",
                        "author": {
                            "steamid": "76561197963932827",
                            "num_reviews": 3,
                            "playtime_forever": 310,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 189,
                            "last_played": 1490755128
                        },
                        "language": "english",
                        "review": "This game is great. You can tell it was actually designed with original NES (Nintendo Entertainment System) hardware in mind. It's not just another one of those million \"retro-inspired\" games that come out every year, this game is the essence of your favorite memories of 1980s horrow games compressed into a neat package. Music and sound effects are great, the character-switching mechanic and health mechanics are awesome, plus the ability to develop your abilities over time is really neat. Playthrough time is quite decent. Well worth the purchase!\n\nAs a huge fan of classic NES games, I'll be keeping my eye on this studio for sure!",
                        "timestamp_created": 1490803501,
                        "timestamp_updated": 1490803501,
