                "reviews": [
                    {
                        "recommendationid": "39360278",
                        "author": {
                            "steamid": "76561198048974498",
                            "num_reviews": 824,
                            "playtime_forever": 155,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 155,
                            "last_played": 1515787501
