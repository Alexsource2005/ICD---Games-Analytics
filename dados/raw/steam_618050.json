                "reviews": [
                    {
                        "recommendationid": "33238454",
                        "author": {
                            "steamid": "76561197993586090",
                            "num_reviews": 46,
                            "playtime_forever": 33,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 33,
                            "last_played": 1499186059
                        },
                        "language": "english",
                        "review": "This game is surprisingly well put together so far. I love the music and art, and the fact that while this is \"horror\" it's mainly puzzle-based horror instead of jump scare horror.\n\nHowever, it is possible to get into \"stuck\" states in this game currently, so make sure to backup your saves regularly. For instance, if you go south after the wrap point after the first boss fight, you'll end up in a cold area with no clear way out, and it's possible to go there before grabbing the coat from the chest. Also, there's a room you can get to in the B zone (east of the room with the yellow crystal) with a treasure chest just past a tricky to avoid monster, but upon leaving that room you're instantly assaulted by a goblin with no way to get back to the regular area without dying.",
                        "timestamp_created": 1499186769,
                        "timestamp_updated": 1499186769,
                        "voted_up": true,
                        "votes_up": 38,
                        "votes_funny": 3,
