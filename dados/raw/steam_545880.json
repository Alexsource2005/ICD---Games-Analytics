                "reviews": [
                    {
                        "recommendationid": "69491315",
                        "author": {
                            "steamid": "76561198009095195",
                            "num_reviews": 29,
                            "playtime_forever": 1140,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 1075,
                            "last_played": 1590213759
