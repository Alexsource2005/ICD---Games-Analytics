                "reviews": [
                    {
                        "recommendationid": "41858706",
                        "author": {
                            "steamid": "76561198336861356",
                            "num_reviews": 16,
                            "playtime_forever": 110,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 110,
                            "last_played": 1525390787
