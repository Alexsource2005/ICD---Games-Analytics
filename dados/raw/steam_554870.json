            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 or higher<br></li><li><strong>Processador:</strong> Intel Core i5-4590 or AMD FX 8350 (equivalent or better)<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GTX 970 or AMD Radeon R9 290 (equivalent or better)<br></li><li><strong>Espaço no disco:</strong> Requer 250 MB de espaço livre<br></li><li><strong>Compatibilidade com R.V.:</strong> SteamVR<br></li><li><strong>Notas adicionais:</strong> SUPERHYPERCUBE is compatible with the HTC VIVE headset. You must own an HTC VIVE and have a compatible computer to play this game.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 or higher<br></li><li><strong>Processador:</strong> Intel Core i5-4590 or AMD FX 8350 (equivalent or better)<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GTX 1060 or AMD Radeon RX 480 (equivalent or better)<br></li><li><strong>Espaço no disco:</strong> Requer 250 MB de espaço livre<br></li><li><strong>Notas adicionais:</strong> SUPERHYPERCUBE is compatible with the HTC VIVE headset. You must own an HTC VIVE and have a compatible computer to play this game.</li></ul>"
