            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 64-bit, Windows 8 64-bit, Windows 10 64-bit<br></li><li><strong>Processador:</strong> i5 2400, FX-6300<br></li><li><strong>Memória:</strong> 10 GB de RAM<br></li><li><strong>Placa gráfica:</strong> R9 270, GTX 660<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 4 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> This is to play the game on lowest settings with medium shadows at around 60FPS@1080p resolution.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 64-bit, Windows 8 64-bit, Windows 10 64-bit<br></li><li><strong>Processador:</strong> i5 6500, AMD FX-8350<br></li><li><strong>Memória:</strong> 12 GB de RAM<br></li><li><strong>Placa gráfica:</strong> R9 290, GTX 970<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 4 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> This is to play the game on High settings at 60FPS@1080p resolution. More CPU power is required on larger servers with more players. Newer i7 CPU's should handle the game easily.</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> OS X 10.8<br></li><li><strong>Processador:</strong> i5/i7 CPU<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> R9 270, GTX 660 equivalent<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 4 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> The game does have Mac support but our Mac testers are quite small to give an accurate minimum specs.</li></ul>",
