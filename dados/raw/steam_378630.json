            "supported_languages": "Inglês<strong>*</strong>, Francês, Italiano<strong>*</strong>, Alemão, Polaco, Russo, Espanhol (Espanha)<br><strong>*</strong>idiomas com suporte total de áudio",
            "reviews": {
                "query_summary": {
                    "num_reviews": 1,
                    "review_score": 7,
                    "review_score_desc": "Positive",
