            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Windows 10 64-bit<br></li><li><strong>Processador:</strong> 4-core / 8-thread, e.g. AMD Ryzen 3 3100 / Intel Core i3-10100<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Dedicated GPU with 4 GB VRAM, Vulkan 1.2 or DirectX 12, e.g. NVIDIA GeForce GTX 1050 Ti / AMD Radeon RX 570. Intel integrated graphics not supported.<br></li><li><strong>DirectX:</strong> Versão 12<br></li><li><strong>Espaço no disco:</strong> Requer 15 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> 64-bit only. Targets 30-45 fps at 1280x800 on the Low preset (Steam Deck class). SSD strongly recommended: the first visit to a city builds it, which is slow on a hard drive.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Windows 11 64-bit<br></li><li><strong>Processador:</strong> 8-core, e.g. AMD Ryzen 7 5800X / Intel Core i7-12700<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce RTX 3060 / AMD Radeon RX 6700 XT, 8 GB VRAM<br></li><li><strong>DirectX:</strong> Versão 12<br></li><li><strong>Espaço no disco:</strong> Requer 15 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> 60 fps at 1920x1080 on High/Ultra. SSD.</li></ul>"
            },
