                "reviews": [
                    {
                        "recommendationid": "239167866",
                        "author": {
                            "steamid": "76561198039854883",
                            "num_reviews": 48,
                            "playtime_forever": 911,
                            "playtime_last_two_weeks": 911,
                            "playtime_at_review": 911,
                            "last_played": 1793598093
