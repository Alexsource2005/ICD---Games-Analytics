                    {
                        "recommendationid": "238484928",
                        "author": {
                            "steamid": "76561198391111078",
                            "num_reviews": 6,
                            "playtime_forever": 221,
                            "playtime_last_two_weeks": 219,
                            "playtime_at_review": 221,
                            "last_played": 1792870494
