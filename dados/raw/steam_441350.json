            "website": "http://www.risingstargames.com",
            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 SP1 / 8 / 8.1 / 10 (64bit)<br></li><li><strong>Processador:</strong> Intel Core i5<br></li><li><strong>Memória:</strong> 6 GB de RAM<br></li><li><strong>Placa gráfica:</strong> GeForce 8xxx Series / Radeon HD 2xxx/HD 3xxx<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 5 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX 9.0c compatible soundcard<br></li><li><strong>Notas adicionais:</strong> Controllers supported, but must be activated in Options &gt; Config &gt; Controls menu on first boot (game will remember settings every time after that)</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 SP1 / 8 / 8.1 / 10 (64bit)<br></li><li><strong>Processador:</strong> Intel Core i7<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> GeForce 200 Series / Radeon HD 5xxx<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 5 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX 9.0c compatible soundcard<br></li><li><strong>Notas adicionais:</strong> Controllers supported, but must be activated in Options &gt; Config &gt; Controls menu on first boot (game will remember settings every time after that)</li></ul>"
