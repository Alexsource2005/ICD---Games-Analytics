            "website": null,
            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Windows 10 Home 64-bit<br></li><li><strong>Processador:</strong> Intel(R) Pentium(R) CPU 4415U @ 2.3GHz (4 CPUs), 2.3GHz<br></li><li><strong>Memória:</strong> 4096 MB de RAM<br></li><li><strong>Placa gráfica:</strong> Intel(R) HD Graphics 610<br></li><li><strong>DirectX:</strong> Versão 12<br></li><li><strong>Espaço no disco:</strong> Requer 999 MB de espaço livre<br></li><li><strong>Placa de som:</strong> N/A<br></li><li><strong>Notas adicionais:</strong> May need to set Quality to 2/3, and Resolution to 5/9</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Windows 10 Home 64-bit<br></li><li><strong>Processador:</strong> Intel(R) Core (TM) i7-6700HQ CPU @ 2.60GHz (8 CPU), ~2.6GHz<br></li><li><strong>Memória:</strong> 8192 MB de RAM<br></li><li><strong>Placa gráfica:</strong> Intel(R) HD Graphics 530<br></li><li><strong>DirectX:</strong> Versão 12<br></li><li><strong>Espaço no disco:</strong> Requer 999 MB de espaço livre<br></li><li><strong>Placa de som:</strong> N/A<br></li><li><strong>Notas adicionais:</strong> Should run smoothly on highest settings: Quality set to 3/3, and Resolution to 9/9</li></ul>"
