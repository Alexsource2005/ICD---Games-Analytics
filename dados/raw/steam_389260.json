                "reviews": [
                    {
                        "recommendationid": "38012797",
                        "author": {
                            "steamid": "76561198066590240",
                            "num_reviews": 3399,
                            "playtime_forever": 15,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 15,
                            "last_played": 1512242116
