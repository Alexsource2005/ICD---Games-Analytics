                "reviews": [
                    {
                        "recommendationid": "22295235",
                        "author": {
                            "steamid": "76561197960912243",
                            "num_reviews": 7,
                            "playtime_forever": 115,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 19,
                            "last_played": 1471903587
