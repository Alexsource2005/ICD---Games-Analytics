            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li>Requer um sistema operativo e processador de 64 bits<br></li><li><strong>Sistema Operativo:</strong> Windows 10 64-bit (version 1909 or later)<br></li><li><strong>Processador:</strong> Intel Core i5-8400 / AMD Ryzen 5 2600, or a Ryzen U/H-series APU (e.g. Ryzen 5 4500U)<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GTX 1060 6GB / AMD RX 580 8GB, or integrated (e.g. AMD Radeon Graphics on Ryzen 4000/5000 APUs) - DirectX 12 Required<br></li><li><strong>DirectX:</strong> Versão 12<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 6 GB de espaço livre<br></li><li><strong>Placa de som:</strong> Microphone required (proximity voice chat)<br></li><li><strong>Notas adicionais:</strong> Integrated graphics are supported but not recommended. Expect roughly 20–30 fps at Low settings, with dips into the teens during heavier scenes. A discrete GPU is recommended for a smooth experience. Online play requires a constant internet connection; there is no LAN or offline multiplayer mode.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li>Requer um sistema operativo e processador de 64 bits<br></li><li><strong>Sistema Operativo:</strong> Windows 11 64-bit<br></li><li><strong>Processador:</strong> Intel Core i5-12400 / AMD Ryzen 5 5600<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA RTX 3060 / AMD RX 6600 XT (8 GB) - Shader Model 6<br></li><li><strong>DirectX:</strong> Versão 12<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 6 GB de espaço livre<br></li><li><strong>Placa de som:</strong> Microphone required (proximity voice chat)<br></li><li><strong>Notas adicionais:</strong> Supports NVIDIA DLSS and AMD FSR. Hosting a full 6-player session is the heaviest workload. The host's PC determines performance for everyone in the group, so the strongest machine should host.</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> macOS 13 Ventura<br></li><li><strong>Processador:</strong> Apple M1<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Apple M1 (integrated)<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 10 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Apple Silicon required. Intel Macs not supported.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> macOS 14 Sonoma or later<br></li><li><strong>Processador:</strong> Processor: Apple M2 or later<br></li><li><strong>Memória:</strong> 16 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Apple M2 (integrated)<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 15 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Apple Silicon required. Intel Macs not supported.</li></ul>"
