                "reviews": [
                    {
                        "recommendationid": "32712280",
                        "author": {
                            "steamid": "76561197999732661",
                            "num_reviews": 105,
                            "playtime_forever": 742,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 740,
                            "last_played": 1512865175
