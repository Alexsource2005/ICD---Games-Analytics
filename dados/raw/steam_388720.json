                "reviews": [
                    {
                        "recommendationid": "17808737",
                        "author": {
                            "steamid": "76561197994239777",
                            "num_reviews": 27,
                            "playtime_forever": 335,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 195,
                            "last_played": 1458809907
