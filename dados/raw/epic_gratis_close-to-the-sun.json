                "about": {
                    "image": {
                        "src": "https://cdn2.unrealengine.com/Diesel%2Fproductv2%2Fclose-to-the-sun%2Fhome%2FEGS_ClosetotheSun_StorminaTeacup_S2-1200x1600-13e1edcf2efc80e099bbae9d99854bb268623bbd.jpg",
