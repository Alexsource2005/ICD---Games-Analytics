                        "recommendationid": "102539342",
                        "author": {
                            "steamid": "76561198444166106",
                            "num_reviews": 6,
                            "playtime_forever": 3437,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 178,
                            "last_played": 1717567507
