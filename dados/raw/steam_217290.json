                "reviews": [
                    {
                        "recommendationid": "8905340",
                        "author": {
                            "steamid": "76561198006834433",
                            "num_reviews": 11,
                            "playtime_forever": 7253,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 3627,
                            "last_played": 1619728273
