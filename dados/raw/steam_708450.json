                "reviews": [
                    {
                        "recommendationid": "40932899",
                        "author": {
                            "steamid": "76561197970693531",
                            "num_reviews": 89,
                            "playtime_forever": 68,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 68,
                            "last_played": 1521521986
                        },
                        "language": "english",
                        "review": "Out of all the RPGmaker type games, this is one of the more boring ones I've played.\n\n- Mostly just banal talking and moving characters to screen transitions\n- Unoriginal art assets\n- Although out of Early Access it's still only 50% complete according to the developer.\n- Very little to actually interact with\n- Story is very familiar to Blair witch and its copy cats,\n- Can not use the WASD keys\n- Store page lists Cards and Achievements but neither are available.\n\nBe forewarned that the developer's previous game \"Last Days\" from 2016 is still not finished and went from paid to free.",
                        "timestamp_created": 1521523193,
                        "timestamp_updated": 1521523193,
                        "voted_up": false,
                        "votes_up": 66,
                        "votes_funny": 1,
                        "weighted_vote_score": 0.8038378357887268,
                        "comment_count": 1,
                        "steam_purchase": false,
                        "received_for_free": false,
                        "written_during_early_access": false,
                        "developer_response": "Sorry that you feel that way. I completely understand why you may be upset with this game. And yes, I know my last game was an absolute mess. I'm past that now and am striving to become a better and more professional developer. Steam probably wasn't the best place to release my first game, but I learned a lot from that experience. I won't leave this game in the dark, as I've made sure to create backups almost every time I add new content or bugfixes. Do remember, this game is a NARRATIVE, I never had any intentions of making a lot to interact with. This game is a very dialogue-heavy experience and is clearly stated in the description of the store page. Anyways, I hope you understand. Cheers!",
                        "timestamp_dev_responded": 1521567630,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
