                "reviews": [
                    {
                        "recommendationid": "239236419",
                        "author": {
                            "steamid": "76561198085993893",
                            "num_reviews": 600,
                            "playtime_forever": 2393,
                            "playtime_last_two_weeks": 2119,
                            "playtime_at_review": 2393,
                            "last_played": 1793339796
                        },
                        "language": "english",
                        "review": "Solar Flux pulled me in with how pretty it is. The glowing suns and the ambient soundtrack make the first few systems feel calm and zen. Collecting plasma and firing it into dying stars is a neat idea, and slingshotting around planets with no friction is satisfying once the momentum finally clicks. It gets a lot harder later on, though. Between one-hit asteroid deaths, limited fuel, shields melting near the sun, and that restart screen you have to click through every single time, I spent some evenings more relieved to finish a level than proud of it. Chasing 3 stars is really a test of timing and precise clicking more than a puzzle, but a few of those runs had elegant solutions that felt great when I found them. I recommend it if you're patient and enjoyed Osmos, but grab it on sale, because the campaign is fairly short for full price.",
                        "timestamp_created": 1793669835,
                        "timestamp_updated": 1793669835,
                        "voted_up": true,
                        "votes_up": 0,
                        "votes_funny": 0,
                        "weighted_vote_score": 0.5,
