240/extras/c951180045277a9a2fa1a01dc58a6a64.poster.avif?t=1743614594\" width=600 height=124 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/c951180045277a9a2fa1a01dc58a6a64.webm?t=1743614594\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/c951180045277a9a2fa1a01dc58a6a64.mp4?t=1743614594\" type=\"video/mp4\"></video></span><br>★ Become immersed in a unique hand-drawn art style ★<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/0a5d1db28c36cf5637ee0a4c9ea6260d.poster.avif?t=1743614594\" width=600 height=124 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/0a5d1db28c36cf5637ee0a4c9ea6260d.webm?t=1743614594\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/0a5d1db28c36cf5637ee0a4c9ea6260d.mp4?t=1743614594\" type=\"video/mp4\"></video></span><br>★ Lose yourself in an imaginative and blood-pumping chiptune soundtrack ★<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/556fd8d73056b1d48d8e9609581e5f76.poster.avif?t=1743614594\" width=600 height=124 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/556fd8d73056b1d48d8e9609581e5f76.webm?t=1743614594\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/454240/extras/556fd8d73056b1d48d8e9609581e5f76.mp4?t=1743614594\" type=\"video/mp4\"></video></span></h2>",
