                "reviews": [
                    {
                        "recommendationid": "38335247",
                        "author": {
                            "steamid": "76561198000604904",
                            "num_reviews": 12,
                            "playtime_forever": 64,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 64,
                            "last_played": 1513458325
