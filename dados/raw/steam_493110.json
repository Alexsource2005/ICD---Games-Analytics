                "reviews": [
                    {
                        "recommendationid": "40871653",
                        "author": {
                            "steamid": "76561197970555914",
                            "num_reviews": 17,
                            "playtime_forever": 93,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 19,
                            "last_played": 1592851796
                        },
                        "language": "english",
                        "review": "The original 'The Sentinel' (or Sentry as it was in the US) is one of those rare perfect games, even the official Sentinel Returns could only add a John Carpenter soundtrack as an improvement.\n\nI so wanted to like this but the changes made to the game rules only break the perfect formula from the original (biggest offender being you can absorb trees whilst unable to see the base meaning there's no need to move until forced by koth's gaze.) A speed run element is added to try and remedy this, but it feels forced and just leaves the game feeling void of the tense atmosphere of the original it's inspired by.\n\nAdd to this a couple of game breaking bugs (level progression not working, energy meter not building) plus full screen not working as well as several minor frustrating issues like a tree that looks absorbed (invisible) will suddenly reappear when you move to the next tree because it's only say 99% absorbed (a fully absorbed noise would instantly fix this) and I've had no choice but to refund and continue firing up the original on an emulator whilst I still wait for that modern Sentinelesque fix.",
                        "timestamp_created": 1521289883,
                        "timestamp_updated": 1521290732,
                        "voted_up": false,
                        "votes_up": 12,
                        "votes_funny": 1,
                        "weighted_vote_score": 0.6811477541923523,
                        "comment_count": 3,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": false,
                        "developer_response": "We're really pleased to announce the upcoming version 2.0 which addresses all of these issues. We've added a new classic mode which encourages a more strategic gameplay. You can't absorb anything you can't see the base of. Movement is via Avatar. Lots of other fixes and tweaks. The latest build is currently available on the beta branch. Feedback welcome, as always, to koth@abbeytek.com.",
                        "timestamp_dev_responded": 1591000861,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
                ],
