                        "recommendationid": "32008934",
                        "author": {
                            "steamid": "76561197976258506",
                            "num_reviews": 67,
                            "playtime_forever": 328,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 316,
                            "last_played": 1675575512
