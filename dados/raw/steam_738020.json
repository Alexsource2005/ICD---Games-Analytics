                "reviews": [
                    {
                        "recommendationid": "40893970",
                        "author": {
                            "steamid": "76561198023175868",
                            "num_reviews": 64,
                            "playtime_forever": 26,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 26,
                            "last_played": 1521272360
