                "reviews": [
                    {
                        "recommendationid": "40563405",
                        "author": {
                            "steamid": "76561198136549520",
                            "num_reviews": 7,
                            "playtime_forever": 172,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 172,
                            "last_played": 1520032764
