                "reviews": [
                    {
                        "recommendationid": "38517107",
                        "author": {
                            "steamid": "76561198071815655",
                            "num_reviews": 62,
                            "playtime_forever": 110,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 110,
                            "last_played": 1513919158
