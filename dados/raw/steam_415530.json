                        "recommendationid": "78586954",
                        "author": {
                            "steamid": "76561197985235696",
                            "num_reviews": 201,
                            "playtime_forever": 124,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 124,
                            "last_played": 1604316205
