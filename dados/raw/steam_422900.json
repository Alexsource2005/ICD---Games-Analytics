                "reviews": [
                    {
                        "recommendationid": "237563510",
                        "author": {
                            "steamid": "76561197982675562",
                            "num_reviews": 15,
                            "playtime_forever": 3710,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 3710,
                            "last_played": 1755162930
