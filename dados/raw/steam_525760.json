                        "recommendationid": "43233687",
                        "author": {
                            "steamid": "76561198066590240",
                            "num_reviews": 3403,
                            "playtime_forever": 20,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 20,
                            "last_played": 1530498276
