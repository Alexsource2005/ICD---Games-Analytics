bc1.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/606d3f6846f2c420210bf6e290977bc1.mp4?t=1522379069\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/7139faa49e3ecee44e336f998860fee4.poster.avif?t=1522379069\" width=400 height=224 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/7139faa49e3ecee44e336f998860fee4.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/7139faa49e3ecee44e336f998860fee4.mp4?t=1522379069\" type=\"video/mp4\"></video></span><br>Enemies hit by long-range magic have the advantage of a high damage output and a large attack range. Fire Master good at long-range high damage monomer output, Frost Master is good at using a wide range of attack skills to kill or fight with multiple enemies.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/c56d1edad22e97c4a5d22f82303825eb.poster.avif?t=1522379069\" width=400 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/c56d1edad22e97c4a5d22f82303825eb.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/c56d1edad22e97c4a5d22f82303825eb.mp4?t=1522379069\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >Voodoo elements make</h2>Summoning long-range occupation, with two skills: Department of dark and light department.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/85f4cd6f79bf8e5dd7b462523ed0366b.poster.avif?t=1522379069\" width=400 height=224 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/85f4cd6f79bf8e5dd7b462523ed0366b.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/85f4cd6f79bf8e5dd7b462523ed0366b.mp4?t=1522379069\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/081f632d03b88ab9c3b4102e119a3825.poster.avif?t=1522379069\" width=400 height=224 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/081f632d03b88ab9c3b4102e119a3825.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/081f632d03b88ab9c3b4102e119a3825.mp4?t=1522379069\" type=\"video/mp4\"></video></span><br>You can fight independently without the help of any teammates. Voodoo that can become summon monsters and specializes in Elemental Light Elemental elements, but also good at using Lightning to kill multiple or single enemies.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/b34b95d4ac75dce6019a51b95a180ea5.poster.avif?t=1522379069\" width=400 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/b34b95d4ac75dce6019a51b95a180ea5.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/b34b95d4ac75dce6019a51b95a180ea5.mp4?t=1522379069\" type=\"video/mp4\"></video></span><br><br>In Titan Siege, you will enter the game as a mercenary.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/c692b008407e83137c8e1b5620ff0aea.poster.avif?t=1522379069\" width=400 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/c692b008407e83137c8e1b5620ff0aea.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/c692b008407e83137c8e1b5620ff0aea.mp4?t=1522379069\" type=\"video/mp4\"></video></span><br>After being destroyed and used by the gods, they will then come to their senses and embark on a road of delusion that will prevent the gods from brutalizing against the earth.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/a3a5f543e4fa3118906c5393feaf8bfe.poster.avif?t=1522379069\" width=400 height=250 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/a3a5f543e4fa3118906c5393feaf8bfe.webm?t=1522379069\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/744700/extras/a3a5f543e4fa3118906c5393feaf8bfe.mp4?t=1522379069\" type=\"video/mp4\"></video></span><br>You can also be a vaunted traveler, a wealthy businessman, a collector of mysterious props, a legendary savior, or even a leader of the people, or a vicious demon Choose your own.",
