        "data": {
            "type": "game",
            "name": "Shred! Remastered",
            "steam_appid": 381590,
            "required_age": 0,
            "is_free": false,
            "controller_support": "full",
            "detailed_description": "<p class=\"bb_paragraph\" >Bust out big tricks and combos across 30+ courses built for flow, rhythm, and style. Inspired by MTB culture and handcrafted by a solo developer who lives and breathes the sport</p><p class=\"bb_paragraph\" >It’s simple, addictive, and completely free of unnecessary filler — a potent downhill cocktail delivered straight into your eyeballs</p><p class=\"bb_paragraph\" >Expect big air, bigger crashes, a wicked soundtrack and a whole bunch of MTB humor thrown in for good measure</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features</strong></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Remade with love, from the ground up to bring “Shred 1” into the modern era!</p></li><li><p class=\"bb_paragraph\" >“Flowy” level design based around the “pump” mechanic makes for a fun, addictive and authentic MTB gameplay experience</p></li><li><p class=\"bb_paragraph\" >Over 30 gnarly trails inspired by real world locations, video segments and MTB culture!</p></li><li><p class=\"bb_paragraph\" >Zero BS...Shred! Remastered’s “pickup and play” appeal is ideal for a quick adrenalin fix!</p></li><li><p class=\"bb_paragraph\" >Full controller support</p></li><li><p class=\"bb_paragraph\" >Bike geeks can nerd out over the references to MTB culture and licenced in-game products from Orange, Halo, Gusset and TSG.</p></li><li><p class=\"bb_paragraph\" >“Get your Shred on” to the awesome new soundtrack</p></li><li><p class=\"bb_paragraph\" >It hopefully has less bugs than the original!</p></li><li><p class=\"bb_paragraph\" >Made by a dude who lives and breathes mountain biking!</p></li></ul>",
            "about_the_game": "<p class=\"bb_paragraph\" >Bust out big tricks and combos across 30+ courses built for flow, rhythm, and style. Inspired by MTB culture and handcrafted by a solo developer who lives and breathes the sport</p><p class=\"bb_paragraph\" >It’s simple, addictive, and completely free of unnecessary filler — a potent downhill cocktail delivered straight into your eyeballs</p><p class=\"bb_paragraph\" >Expect big air, bigger crashes, a wicked soundtrack and a whole bunch of MTB humor thrown in for good measure</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features</strong></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Remade with love, from the ground up to bring “Shred 1” into the modern era!</p></li><li><p class=\"bb_paragraph\" >“Flowy” level design based around the “pump” mechanic makes for a fun, addictive and authentic MTB gameplay experience</p></li><li><p class=\"bb_paragraph\" >Over 30 gnarly trails inspired by real world locations, video segments and MTB culture!</p></li><li><p class=\"bb_paragraph\" >Zero BS...Shred! Remastered’s “pickup and play” appeal is ideal for a quick adrenalin fix!</p></li><li><p class=\"bb_paragraph\" >Full controller support</p></li><li><p class=\"bb_paragraph\" >Bike geeks can nerd out over the references to MTB culture and licenced in-game products from Orange, Halo, Gusset and TSG.</p></li><li><p class=\"bb_paragraph\" >“Get your Shred on” to the awesome new soundtrack</p></li><li><p class=\"bb_paragraph\" >It hopefully has less bugs than the original!</p></li><li><p class=\"bb_paragraph\" >Made by a dude who lives and breathes mountain biking!</p></li></ul>",
            "short_description": "Tear it up across 30+ hand-built courses of pure downhill flow - a mashup of MTB films and riding culture, as if someone fed an entire bike park into a game engine and set the output to maximum flow",
            "supported_languages": "Inglês<strong>*</strong><br><strong>*</strong>idiomas com suporte total de áudio",
            "header_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/381590/a5f702d47f396f4c2fde2abb12287335cbaff7f8/header.jpg?t=1778242526",
            "capsule_image": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/381590/847fbc185bc7a3f9cafb91af447c65c4df50dc5c/capsule_231x87.jpg?t=1778242526",
            "capsule_imagev5": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/381590/847fbc185bc7a3f9cafb91af447c65c4df50dc5c/capsule_184x69.jpg?t=1778242526",
            "website": "http://www.asbointeractive.com",
            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7<br></li><li><strong>Processador:</strong> Dual Core Intel<br></li><li><strong>Memória:</strong> 1 GB de RAM<br></li><li><strong>Placa gráfica:</strong> 512MB Direct X9 compatible on board graphics<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 1 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Includes graphical options to increase compatibility on some on-board Intel based chipsets and older graphics hardware</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7<br></li><li><strong>Processador:</strong> Quad Core Intel<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> 1GB Direct X9 compatible Nvidia or ATI dedicated video card<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 1 GB de espaço livre</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> OSX Yosemite<br></li><li><strong>Processador:</strong> Dual Core Mac Mini or similar<br></li><li><strong>Memória:</strong> 1 GB de RAM<br></li><li><strong>Placa gráfica:</strong> 512mb On-board Graphics<br></li><li><strong>Espaço no disco:</strong> Requer 1 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Option included within game to run on Intel based graphics hardware commonly found in Mac Mini.  Xbox controller support using Tattie Bolge driver included but remains untested at this stage!</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> OSX Yosemite<br></li><li><strong>Processador:</strong> Quad Core Intel/intel i5 or better<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> 1GB Dedicated Graphics<br></li><li><strong>Espaço no disco:</strong> Requer 1 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Option included within game to run on Intel based graphics hardware commonly found in Mac Mini. Xbox controller support using Tattie Bolge driver included but remains untested at this stage!</li></ul>"
