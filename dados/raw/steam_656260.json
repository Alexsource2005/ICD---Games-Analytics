                "reviews": [
                    {
                        "recommendationid": "38353659",
                        "author": {
                            "steamid": "76561198073239654",
                            "num_reviews": 7,
                            "playtime_forever": 9,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 9,
                            "last_played": 1513439080
                        },
                        "language": "english",
                        "review": "My back and neck hurt man, I like the idea, and to be honest, it truly helps decreasing the sickness caused by locomotion, It's a serious problem for Asian people who wanna spend more time in VR, but I just can't repeat the lean forward actions again and again and again, I just can't, keep working guys, I can feel that you guys are in the right direction. BTW I tried to start a game with somebody or bots,  but i failed, i don't know.",
                        "timestamp_created": 1513439900,
                        "timestamp_updated": 1513439900,
                        "voted_up": false,
                        "votes_up": 17,
                        "votes_funny": 1,
                        "weighted_vote_score": 0.7084770202636719,
                        "comment_count": 3,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": true,
                        "developer_response": "HI, \n\nThanks for the feedback. Over the course of a year we have been refining the Hyper Dash calibration to best match the body’s natural movement. For that reason, you can actually customize the Hyper Dash sensitivity on the in-game-calibration menu. This allows you to precisely control your dash threshold to your personal preference. If you loosen the sensitivity it gives you much easier range of dash.  Some quick examples from Pax West and Dream Hack gave us great data for calibrating the best starting default values. \n\nhttps://www.youtube.com/watch?v=sfiJHAMheu8\n",
                        "timestamp_dev_responded": 1513668196,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
