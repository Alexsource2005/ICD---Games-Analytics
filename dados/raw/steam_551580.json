                "reviews": [
                    {
                        "recommendationid": "32155799",
                        "author": {
                            "steamid": "76561197996066202",
                            "num_reviews": 20,
                            "playtime_forever": 333,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 333,
                            "last_played": 1493985948
