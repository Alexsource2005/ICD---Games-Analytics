                "reviews": [
                    {
                        "recommendationid": "239375708",
                        "author": {
                            "steamid": "76561199383728602",
                            "num_reviews": 8,
                            "playtime_forever": 10370,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 10370,
                            "last_played": 1788945442
