                "reviews": [
                    {
                        "recommendationid": "33677904",
                        "author": {
                            "steamid": "76561197974684495",
                            "num_reviews": 21,
                            "playtime_forever": 862,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 312,
                            "last_played": 1536273429
