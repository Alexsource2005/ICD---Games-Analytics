                "reviews": [
                    {
                        "recommendationid": "28121468",
                        "author": {
                            "steamid": "76561197963466485",
                            "num_reviews": 21,
                            "playtime_forever": 10,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 10,
                            "last_played": 1480418173
                        },
                        "language": "english",
                        "review": "This game has nothing to do with \"learning\" meditation. I will explain simply what this game does.\n\n1. You pick a location\n2. You hold the controller to your chest and a big floating ball floats in front of you inflating and deflating as you breath\n\nThat is all this game does. No voice explaning any exercises or anything\n\nShould be reported to be honest for naming the game \"Learn meditation\"",
                        "timestamp_created": 1480607776,
                        "timestamp_updated": 1480607776,
                        "voted_up": false,
                        "votes_up": 20,
                        "votes_funny": 0,
                        "weighted_vote_score": 0.7184107303619385,
                        "comment_count": 2,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": true,
                        "developer_response": "Hi Hellmo,\n\nThanks for checking out our app.   I'm sorry it didn't meet your expectations.  \n\nWe're considering adding guided meditations to the app once it's available for GA.  Is that something that would make you be interested in checking out the app again?  What else would you like to see?  You might also check out the computer-guided breathing and the music in-app until we reach GA.\n\nBest,\n@owocki\n",
                        "timestamp_dev_responded": 1480613907,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
                ],
