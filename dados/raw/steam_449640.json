            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 64-bit (Service Pack 1) or newer<br></li><li><strong>Processador:</strong> Intel i5-4590 equivalent or greater (VR), Intel(R) Core(TM)2 Quad CPU Q6600 2.40GHz (4 CPUs), ~2.4GHz (Non-VR)<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GTX 970 or AMD 290 equivalent or greater  (VR), AMD Radeon HD 7700 Series or equivalent (Non-VR)<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 8 GB de espaço livre<br></li><li><strong>Compatibilidade com R.V.:</strong> SteamVR or Oculus PC. Keyboard or gamepad required<br></li><li><strong>Notas adicionais:</strong> Video Output: HDMI 1.4 or DisplayPort 1.2 or newer, USB Ports: One USB 2.0 or greater</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 8 or newer<br></li><li><strong>Processador:</strong> Intel i5-6600K / AMD FX8350 or greater<br></li><li><strong>Memória:</strong> 32 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GTX 980 / AMD Radeon R9 290X equivalent or greater<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 8 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Video Output: Compatible HDMI 1.3 video output, USB Ports: 1x USB 3.0 port, plus 2x USB 2.0 ports</li></ul>"
