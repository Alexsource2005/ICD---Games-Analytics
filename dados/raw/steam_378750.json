        "data": {
            "type": "game",
            "name": "Sayonara Umihara Kawase",
            "steam_appid": 378750,
            "required_age": 0,
            "is_free": false,
            "controller_support": "full",
            "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/378750/extras/f79bb227aa8b7a86d673b03f79b7fe38.avif?t=1789102916\" width=600 height=220 /></span></p><h2 class=\"bb_tag\" >The latest entry in the Umihara Kawase series is now available on Steam!</h2><p class=\"bb_paragraph\" >In 1994, Umihara Kawase was released for the Super Famicom, followed by Umihara Kawase Shun for the PlayStation in 1997. </p><p class=\"bb_paragraph\" >Now, the official sequel to this beloved puzzle platformer action game, which continues to captivate fans with its unique action mechanics, is on Steam!</p><h2 class=\"bb_tag\" >Elastic &quot;Rubbering Action&quot;</h2><p class=\"bb_paragraph\" >A &quot;Rubbering Action&quot; game where you use a rubber rope with a fishing lure attached to its end to make your way through each stage. </p><p class=\"bb_paragraph\" >Hook the lure onto walls and use the momentum generated by the recoil of the elastic rope to climb to higher areas, or swing like a pendulum to leap across gaps.</p><p class=\"bb_paragraph\" >The unique action made possible by the highly elastic rope is unlike anything found in other games, making this title truly unique!</p><h2 class=\"bb_tag\" >Created by the Original Development Team!</h2><p class=\"bb_paragraph\" >The Steam version was created by the original Umihara Kawase development team, with the original staff handling every aspect of the game, including game design, programming, character design, and sound.</p><p class=\"bb_paragraph\" >While preserving the appeal of the series that began with the original game, this version also incorporates features unique to Steam, making it enjoyable for everyone from newcomers to longtime fans.</p><h2 class=\"bb_tag\" >Credits</h2><p class=\"bb_paragraph\" >Game Design &amp; Lead Programmer:</p><p class=\"bb_paragraph\" >Kiyoshi Sakai</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Character Design:</p><p class=\"bb_paragraph\" >Toshinobu Kondo</p>",
            "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/378750/extras/f79bb227aa8b7a86d673b03f79b7fe38.avif?t=1789102916\" width=600 height=220 /></span></p><h2 class=\"bb_tag\" >The latest entry in the Umihara Kawase series is now available on Steam!</h2><p class=\"bb_paragraph\" >In 1994, Umihara Kawase was released for the Super Famicom, followed by Umihara Kawase Shun for the PlayStation in 1997. </p><p class=\"bb_paragraph\" >Now, the official sequel to this beloved puzzle platformer action game, which continues to captivate fans with its unique action mechanics, is on Steam!</p><h2 class=\"bb_tag\" >Elastic &quot;Rubbering Action&quot;</h2><p class=\"bb_paragraph\" >A &quot;Rubbering Action&quot; game where you use a rubber rope with a fishing lure attached to its end to make your way through each stage. </p><p class=\"bb_paragraph\" >Hook the lure onto walls and use the momentum generated by the recoil of the elastic rope to climb to higher areas, or swing like a pendulum to leap across gaps.</p><p class=\"bb_paragraph\" >The unique action made possible by the highly elastic rope is unlike anything found in other games, making this title truly unique!</p><h2 class=\"bb_tag\" >Created by the Original Development Team!</h2><p class=\"bb_paragraph\" >The Steam version was created by the original Umihara Kawase development team, with the original staff handling every aspect of the game, including game design, programming, character design, and sound.</p><p class=\"bb_paragraph\" >While preserving the appeal of the series that began with the original game, this version also incorporates features unique to Steam, making it enjoyable for everyone from newcomers to longtime fans.</p><h2 class=\"bb_tag\" >Credits</h2><p class=\"bb_paragraph\" >Game Design &amp; Lead Programmer:</p><p class=\"bb_paragraph\" >Kiyoshi Sakai</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Character Design:</p><p class=\"bb_paragraph\" >Toshinobu Kondo</p>",
            "short_description": "The definitive sequel to the popular series that began with Umihara Kawase in 1994 and Umihara Kawase Shun in 1997 comes to Steam! Master the stretchy rubber rope and use recoil and pendulum motion to reach the goal. Experience the one-of-a-kind “Rubbering Action” game from the original team!",
            "supported_languages": "Inglês, Francês, Italiano, Alemão, Espanhol (Espanha), Japonês, Português (Brasil), Russo",
