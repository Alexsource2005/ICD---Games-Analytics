                "reviews": [
                    {
                        "recommendationid": "236538269",
                        "author": {
                            "steamid": "76561198371440609",
                            "num_reviews": 47,
                            "playtime_forever": 169,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 135,
                            "last_played": 1790769637
