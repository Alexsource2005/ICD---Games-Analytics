                "reviews": [
                    {
                        "recommendationid": "239226760",
                        "author": {
                            "steamid": "76561198307522478",
                            "num_reviews": 7,
                            "playtime_forever": 120,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 120,
                            "last_played": 1768353707
