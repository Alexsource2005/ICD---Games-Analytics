                "reviews": [
                    {
                        "recommendationid": "236725900",
                        "author": {
                            "steamid": "76561198098287006",
                            "num_reviews": 12,
                            "playtime_forever": 61,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 10,
                            "last_played": 1792596048
