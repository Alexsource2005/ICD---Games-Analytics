                "reviews": [
                    {
                        "recommendationid": "237185709",
                        "author": {
                            "steamid": "76561198154275074",
                            "num_reviews": 353,
                            "playtime_forever": 718,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 718,
                            "last_played": 1791440975
