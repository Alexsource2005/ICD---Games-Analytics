            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li>Requer um sistema operativo e processador de 64 bits<br></li><li><strong>Sistema Operativo *:</strong> Windows 7 64-bit or later (64-Bit ONLY)<br></li><li><strong>Processador:</strong> Quad-core Intel or AMD processor, 2.5 GHz or faster.<br></li><li><strong>Memória:</strong> 6 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 760 or AMD Radeon R9 280X series card or higher.<br></li><li><strong>DirectX:</strong> Versão 10<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 20 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Dedicated Graphics Card Strongly Recommended. This game won't run well on laptops, notebooks etc.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li>Requer um sistema operativo e processador de 64 bits<br></li><li><strong>Sistema Operativo:</strong> Windows 10 64-bit<br></li><li><strong>Processador:</strong> Quad-core Intel or AMD processor, 3.5 GHz or faster.<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 960 series card or higher.<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 20 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Experimental Direct X 12 with Windows 10. Use -DX12 in the launch arguments.</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> macOS 10.13: High Sierra (64 Bit ONLY)<br></li><li><strong>Processador:</strong> Quad-core Intel or AMD processor, 2.5 GHz or faster.<br></li><li><strong>Memória:</strong> 6 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Dedicated Metal Compatible GPU with at least 2 GB VRAM<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 20 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Mac must support the Metal Rendering API and be from 2014 or later. The game will not run on Macbook Air / Low End Macbooks / Mac Mini.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"></ul>"
