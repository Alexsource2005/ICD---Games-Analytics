atic.com/store_item_assets/steam/apps/724950/extras/56d655765888c7df635132235ab7f106.mp4?t=1562801911\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/724950/extras/a2466da9e6c69caa24c215345e2df80a.poster.avif?t=1562801911\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/724950/extras/a2466da9e6c69caa24c215345e2df80a.webm?t=1562801911\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/724950/extras/a2466da9e6c69caa24c215345e2df80a.mp4?t=1562801911\" type=\"video/mp4\"></video></span>",
