                "reviews": [
                    {
                        "recommendationid": "18136691",
                        "author": {
                            "steamid": "76561198093417321",
                            "num_reviews": 2,
                            "playtime_forever": 2039,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 378,
                            "last_played": 1567266974
