store_item_assets/steam/apps/722290/extras/3f5020aa4bdc7e6ad3e233dd3dab9ba0.mp4?t=1596293150\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" ><strong>Level Editor</strong></h2><i>Create unique trails yourself or import GPX files.</i><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/722290/extras/cd1b7a1a575f6c03b1bfc63c606e427e.poster.avif?t=1596293150\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/722290/extras/cd1b7a1a575f6c03b1bfc63c606e427e.webm?t=1596293150\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/722290/extras/cd1b7a1a575f6c03b1bfc63c606e427e.mp4?t=1596293150\" type=\"video/mp4\"></video></span>",
