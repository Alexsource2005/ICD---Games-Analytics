                "reviews": [
                    {
                        "recommendationid": "83518538",
                        "author": {
                            "steamid": "76561198963681119",
                            "num_reviews": 7,
                            "playtime_forever": 305,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 298,
                            "last_played": 1613080516
                        },
                        "language": "english",
                        "review": "If you think you can play this game as usually you do with other games, then don't buy it. Cause this game is an intense, deep emotional journey for which you need to have a certain \"sensitivity\", and it must be lived as such until the end. Forget for a moment having to \"unlock\" all the achievements, don't rush to finish...but let the game guide you in the mind and in the soul of the protagonist. Is it possible to have memory of what our past life was and be able to survive the pain that we ourselves have caused to our loved ones? Remembering sometimes helps to repair our mistakes.",
