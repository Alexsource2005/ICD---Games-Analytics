                "reviews": [
                    {
                        "recommendationid": "47739025",
                        "author": {
                            "steamid": "76561198035345202",
                            "num_reviews": 85,
                            "playtime_forever": 56,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 56,
                            "last_played": 1545464418
