                "reviews": [
                    {
                        "recommendationid": "39586383",
                        "author": {
                            "steamid": "76561198032088203",
                            "num_reviews": 144,
                            "playtime_forever": 13,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 13,
                            "last_played": 1516687146
