                "reviews": [
                    {
                        "recommendationid": "239780618",
                        "author": {
                            "steamid": "76561198166090352",
                            "num_reviews": 38,
                            "playtime_forever": 73,
                            "playtime_last_two_weeks": 73,
                            "playtime_at_review": 73,
                            "last_played": 1794207292
