                "reviews": [
                    {
                        "recommendationid": "44620162",
                        "author": {
                            "steamid": "76561198088228422",
                            "num_reviews": 2,
                            "playtime_forever": 293,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 124,
                            "last_played": 1547169478
