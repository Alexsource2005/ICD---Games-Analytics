                        "recommendationid": "35074899",
                        "author": {
                            "steamid": "76561198071845080",
                            "num_reviews": 22,
                            "playtime_forever": 128,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 42,
                            "last_played": 1724214102
