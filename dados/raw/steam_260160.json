            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows Vista / 7<br></li><li><strong>Processador:</strong> Intel Dual-Core 2.6 GHz / AMD Dual-Core Athlon 3.0 GHz<br></li><li><strong>Memória:</strong> 2 GB de RAM<br></li><li><strong>Placa gráfica:</strong> SM 3.0 with 512MB VRAM; NVIDIA GeForce 8500 GT / AMD Radeon HD 4650 or greater<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX Compatible<br></li><li><strong>Notas adicionais:</strong> Keyboard and mouse with mouse-wheel.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 or higher<br></li><li><strong>Processador:</strong> Quad-Core Processor<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> SM 3.0 with 1GB VRAM; NVIDIA GeForce GTX 280 / AMD Radeon HD 4830 or greater<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX Compatible<br></li><li><strong>Notas adicionais:</strong> ONLY XBOX 360 CONTROLLER SUPPORTED</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Mac OS X 10.6 Snow Leopard<br></li><li><strong>Processador:</strong> Intel Dual-Core 2.4 GHz<br></li><li><strong>Memória:</strong> 2 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce 640M / ATI Radeon HD 5750 with at least 512MB VRAM<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Keyboard and mouse with mouse-wheel.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Mac OS X 10.9 Mavericks or higher<br></li><li><strong>Processador:</strong> Quad-Core Processor<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce 640M / ATI Radeon HD 6750M with at least 1GB VRAM<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> ONLY SONY DUALSHOCK®3 CONTROLLER SUPPORTED</li></ul>"
            },
            "linux_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Ubuntu 12.10 LTS<br></li><li><strong>Processador:</strong> Intel Dual-Core 2.9 GHz / AMD Dual-Core 3.5 GHz<br></li><li><strong>Memória:</strong> 2 GB de RAM<br></li><li><strong>Placa gráfica:</strong> SM 3.0 with 512MB VRAM; NVIDIA GeForce GTX 550 Ti / AMD Radeon HD 6670 or greater<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Keyboard and mouse with mouse-wheel. To run the game on a 64-bit system you have to install the 32-bit libraries. (sudo apt-get install libgtk2.0-0:i386 libpangox-1.0-0:i386 libpangoxft-1.0-0:i386 libidn11:i386 libglu1-mesa:i386, sudo apt-get install ia32-libs)</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Ubuntu 13.10<br></li><li><strong>Processador:</strong> Quad-Core Processor<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> SM 3.0 with 1GB VRAM; NVIDIA GeForce GTX 770 / AMD Radeon HD 7970 or greater<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Proprietary GPU drivers installed. To run the game on a 64-bit system you have to install the 32-bit libraries. (sudo apt-get install libgtk2.0-0:i386 libpangox-1.0-0:i386 libpangoxft-1.0-0:i386 libidn11:i386 libglu1-mesa:i386, sudo apt-get install ia32-libs)</li></ul>"
