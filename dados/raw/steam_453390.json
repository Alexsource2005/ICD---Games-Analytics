                "reviews": [
                    {
                        "recommendationid": "236960376",
                        "author": {
                            "steamid": "76561198377829363",
                            "num_reviews": 2,
                            "playtime_forever": 193,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 193,
                            "last_played": 1791197884
