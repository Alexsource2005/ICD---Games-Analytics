            "reviews": {
                "query_summary": {
                    "num_reviews": 1,
                    "review_score": 6,
                    "review_score_desc": "Mostly Positive",
                    "total_positive": 23,
                    "total_negative": 6,
                    "total_reviews": 29
                },
                "reviews": [
                    {
                        "recommendationid": "32850132",
                        "author": {
                            "steamid": "76561198086411970",
                            "num_reviews": 2,
                            "playtime_forever": 369,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 369,
                            "last_played": 1503313521
                        },
                        "language": "english",
                        "review": "The translation for this game is absolutely terrible. You should not have to think, \"what on earth does this line even mean?\", every single time a new sentence pops up on screen, when reading an official translation. The quality of this translation is worse than most fan translations out there. It is beyond just awkward grammar and a few literal TLs. It is as stiff as a machine translation. I have gone through about 5 hours of this game, comparing the Japanese lines to the English, and the translators clearly knew essentially no English. They have translated every single line so literally, that it just turns into a big mess. For instance, a blow to the stomach became \"stomach bam\". The sun being extremely hot = \"the sun exploded\". As funny as the line \"a stomach bam\" is, it is not okay for stuff like that to be left in a translation that we paid money for. \n\nI have a thread on Fuwanovel where I show some screenshots, and others also share some examples of the terrible translation. Please, read this thread before even thinking about buying this game in its current state. \nhttps://forums.fuwanovel.net/topic/17917-kyuuketsuki-no-libra-tl-quality/",
                        "timestamp_created": 1498559903,
                        "timestamp_updated": 1498559903,
                        "voted_up": false,
