                "reviews": [
                    {
                        "recommendationid": "41245378",
                        "author": {
                            "steamid": "76561198040908384",
                            "num_reviews": 6,
                            "playtime_forever": 70,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 70,
                            "last_played": 1522745806
