                "reviews": [
                    {
                        "recommendationid": "234272170",
                        "author": {
                            "steamid": "76561198060880169",
                            "num_reviews": 25,
                            "playtime_forever": 203,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 201,
                            "last_played": 1788789617
                        },
                        "language": "english",
                        "review": "This game had promise, however it's too awkward a mix of platforming and combat that ends up with both mechanics clashing in such a way that neither one comes out good. On one hand you have levels with very tight platforming and a speedrun mechanic, which would be fun on its own, but is ruined by the numerous annoying enemies that stand in your way, slowing you down and halting your progress. Then you have dangerous enemies that are somewhat fun to fight, but that's ruined by the extremely small platforms with no room to maneuver or dodge, extremely fast attacks and movement, and no easy to tell wind-up motion for attacks which makes dodging or attacking extremely difficult. Overall an interesting idea, but not well polished enough to be enjoyable.",
