                    {
                        "recommendationid": "237595187",
                        "author": {
                            "steamid": "76561197970731820",
                            "num_reviews": 17,
                            "playtime_forever": 281,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 281,
                            "last_played": 1791851918
