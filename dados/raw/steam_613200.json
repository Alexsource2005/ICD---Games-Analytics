                "reviews": [
                    {
                        "recommendationid": "31409767",
                        "author": {
                            "steamid": "76561197963580550",
                            "num_reviews": 62,
                            "playtime_forever": 173,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 60,
                            "last_played": 1494481805
                        },
                        "language": "english",
                        "review": "Pros:  \n\n+ Challenging with plenty of zombies swarming you, especially harder in night mode\n+ Decent assortment of guns - and you can go akimbo (wielding 2 guns) with pistols and uzis\n+ Accurate hit boxes and shooting\n+ Fun for a few hours and worth the $3 I paid for it\n\nCons:\n\n- Only 4 levels that look very similar\n- Only 4 types of zombies (regular zombie, running zombie, giant zombie and spitting zombie) - but at least there are various skins \n- Some weapons aren't very powerful and feel completely useless in the mix\n- Very shallow progression: kill zombies to level up and earn a new gun each level\n\n",
                        "timestamp_created": 1493360585,
                        "timestamp_updated": 1493360585,
                        "voted_up": true,
                        "votes_up": 6,
                        "votes_funny": 0,
                        "weighted_vote_score": 0.6031268835067749,
