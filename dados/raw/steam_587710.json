                "reviews": [
                    {
                        "recommendationid": "38925972",
                        "author": {
                            "steamid": "76561198066590240",
                            "num_reviews": 3404,
                            "playtime_forever": 24,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 24,
                            "last_played": 1514779286
