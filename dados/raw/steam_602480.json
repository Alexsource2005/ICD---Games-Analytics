                "reviews": [
                    {
                        "recommendationid": "35993270",
                        "author": {
                            "steamid": "76561198055721318",
                            "num_reviews": 9,
                            "playtime_forever": 106,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 63,
                            "last_played": 1544637410
