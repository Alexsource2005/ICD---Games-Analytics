                "reviews": [
                    {
                        "recommendationid": "238246157",
                        "author": {
                            "steamid": "76561199213720501",
                            "num_reviews": 6,
                            "playtime_forever": 15065,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 15065,
                            "last_played": 1782676858
                        },
                        "language": "english",
                        "review": "This game is the textbook definition of a \"Potential Man\", and much like many Potential Men, this game completely fails at fulfilling its true potential. For starters, this game has basically received no new meaningful content for the past year and a half, save for one copy-pasted tank and a new DLC (this is a separate issue). No real major updates, and definitely not enough content to justify its price. On top of this, the game is very unoptimized, with even my RX 9070 XT being brought to its knees at times. Finally, the most major issue is that there is basically no communication from the developers themselves, so the community is left on read for months at a time. It really sucks that such a great concept like this couldn't be realized, but there will probably be another attempt by some other dev in the future, so look out for that.",
