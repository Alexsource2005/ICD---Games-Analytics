                "reviews": [
                    {
                        "recommendationid": "39354373",
                        "author": {
                            "steamid": "76561197979348554",
                            "num_reviews": 44,
                            "playtime_forever": 157,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 157,
                            "last_played": 1515980982
