                "navOrder": 1,
                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "™ & © 2022 Bloober Team S.A. (Inc.). All other copyrights and trademarks are the property of their respective owners. All Rights Reserved. ",
                    "privacyPolicyLink": {
