                        "recommendationid": "237742397",
                        "author": {
                            "steamid": "76561198039871743",
                            "num_reviews": 28,
                            "playtime_forever": 1029,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 1029,
                            "last_played": 1791772395
