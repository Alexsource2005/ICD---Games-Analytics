                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Overcooked. Desenvolvido por Ghost Town Games Ltd © 2016. Publicado por Team17 Digital Ltd. Team17 é uma marca comercial ou marca registrada da Team17 Digital Limited. Todas as outras marcas comerciais, direitos autorais e logos são propriedade de seus respectivos detentores.",
                    "privacyPolicyLink": {
