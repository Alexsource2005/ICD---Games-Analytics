                "reviews": [
                    {
                        "recommendationid": "238557516",
                        "author": {
                            "steamid": "76561198169085960",
                            "num_reviews": 27,
                            "playtime_forever": 834,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 834,
                            "deck_playtime_at_review": 20,
                            "last_played": 1792947915
