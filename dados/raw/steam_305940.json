            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows XP, Vista, 7, 8.1, 10 (64-bit)<br></li><li><strong>Processador:</strong> 2 GHz<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> AMD/NVIDIA card, 1GB<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Placa de som:</strong> Any OpenAL compatible<br></li><li><strong>Notas adicionais:</strong> We recommend a resolution of at least 1600x900 or similar.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows Vista, 7, 8.1, 10 (64-bit)<br></li><li><strong>Processador:</strong> 3 GHz<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> AMD/NVIDIA card, 2GB<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Placa de som:</strong> Any OpenAL compatible<br></li><li><strong>Notas adicionais:</strong> For the best play experience, we recommend a resolution of 1920x1080 (Full HD) or similar.</li></ul>"
