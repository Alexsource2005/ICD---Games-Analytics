                "reviews": [
                    {
                        "recommendationid": "26224316",
                        "author": {
                            "steamid": "76561198088224397",
                            "num_reviews": 21,
                            "playtime_forever": 42,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 39,
                            "last_played": 1531102643
