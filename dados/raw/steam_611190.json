                "reviews": [
                    {
                        "recommendationid": "133397762",
                        "author": {
                            "steamid": "76561197969741326",
                            "num_reviews": 2,
                            "playtime_forever": 1426,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 208,
                            "last_played": 1677950494
                        },
                        "language": "english",
                        "review": "Really good lighting, cool weapons, neat upgrades, intriguing story, and lots of little secret areas. Unfortunately, dying means you have to replay the entire chapter. Taking your time to find all the secrets and collect all the loot is fun, but only once or twice. After that, it becomes tedious and annoying. I wish there was some kind of midpoint save feature so I didn't have to replay the entire level. I'm ok replaying part of the level, but faced with replaying the entire thing, I'd rather just quit.",
                        "timestamp_created": 1677127867,
                        "timestamp_updated": 1677127867,
                        "voted_up": false,
                        "votes_up": 23,
                        "votes_funny": 2,
                        "weighted_vote_score": 0.6962640285491943,
                        "comment_count": 0,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": false,
                        "developer_response": "Thanks for the review and for also taking the time to mention the good things you liked about the game.\n\nPlease note that the number of spare lives you receive for a single run, is related to the chosen difficulty level.\n\nBut I can understand your point as well, that when playing Story mode, it could be frustrating to run out of lives in a single run (chapter). I will take this into consideration for some potential tweaks in the upcoming update. It's impossible to promise anything specific, because I have to think about it carefully.",
                        "timestamp_dev_responded": 1677141247,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
                ],
