                "reviews": [
                    {
                        "recommendationid": "237762252",
                        "author": {
                            "steamid": "76561199162015154",
                            "num_reviews": 17,
                            "playtime_forever": 265,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 265,
                            "last_played": 1792055107
