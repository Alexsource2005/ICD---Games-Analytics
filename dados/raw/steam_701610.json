                "reviews": [
                    {
                        "recommendationid": "55470750",
                        "author": {
                            "steamid": "76561198008785639",
                            "num_reviews": 15,
                            "playtime_forever": 194,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 194,
                            "last_played": 1570329136
                        },
                        "language": "english",
                        "review": "This game is not currently ready for release. I wish it was. The bad script translation I can get over. but the fact that aim is done in weird jumping increments makes it annoying and sometimes impossible to hit your target. Though they seem to be able to shot from any angle, not specific increments like we do. Then there's the fact that sometimes loot and hell even attacks will go through walls. oh sorry, not your attacks just the enemies. I like my games hard and challenging. and I'll play game in alpha phase and expect bugs. but I will not except bugs in a finished game. at least not on this level. You need a game tester badly. and need to take this down because it's not finished. I'm going to see if I can refund it. not wasting $10 on this.",
                        "timestamp_created": 1570329416,
                        "timestamp_updated": 1570329416,
                        "voted_up": false,
                        "votes_up": 17,
                        "votes_funny": 0,
                        "weighted_vote_score": 0.6982875466346741,
                        "comment_count": 0,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": false,
                        "developer_response": "Hi,\nI am sorry that the bugs ruined your experience. I've been fixing them week after week since the release. After reading your feedback I improved the shooting script so there's no more increments. Who knows maybe You'll decide to give the game one more chance :)\nYou can read more details about the accuracy fix in the patch notes below:\nhttps://steamcommunity.com/gid/103582791462667231/announcements/detail/3033663093813902088\n\nWish you all the best,\nKrystian",
                        "timestamp_dev_responded": 1574888228,
