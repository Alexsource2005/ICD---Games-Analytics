                "reviews": [
                    {
                        "recommendationid": "40241979",
                        "author": {
                            "steamid": "76561198134219338",
                            "num_reviews": 984,
                            "playtime_forever": 160,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 30,
                            "last_played": 1633567057
