                "reviews": [
                    {
                        "recommendationid": "237560340",
                        "author": {
                            "steamid": "76561198047060973",
                            "num_reviews": 17,
                            "playtime_forever": 2455,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 2455,
                            "last_played": 1791770697
