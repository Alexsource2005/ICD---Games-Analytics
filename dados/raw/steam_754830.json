                "reviews": [
                    {
                        "recommendationid": "50845022",
                        "author": {
                            "steamid": "76561198039150619",
                            "num_reviews": 98,
                            "playtime_forever": 414,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 349,
                            "last_played": 1733088309
