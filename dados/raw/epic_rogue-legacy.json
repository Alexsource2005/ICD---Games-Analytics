                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "Copyright(C) 2013-2022, Cellar Door Games Inc. Rogue Legacy (TM) is a trademark or registered trademark of Cellar Door Games Inc. All Rights Reserved.",
                    "privacyPolicyLink": {
