                    {
                        "recommendationid": "228330198",
                        "author": {
                            "steamid": "76561197963330804",
                            "num_reviews": 620,
                            "playtime_forever": 64,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 64,
                            "last_played": 1781874810
