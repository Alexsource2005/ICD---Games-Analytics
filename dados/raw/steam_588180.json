            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 / 8 / 8.1 / 10 (both the 32-bit and 64-bit versions are supported)<br></li><li><strong>Processador:</strong> Intel Core2 Duo E7200 / AMD Athlon X2 255 or equivalent<br></li><li><strong>Memória:</strong> 2 GB de RAM<br></li><li><strong>Placa gráfica:</strong> Intel HD Family or equivalent with 1GB RAM (Shader Model 3.0 compliant)<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 320 MB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Gamepad highly recommended</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 / 8 / 8.1 / 10 (both the 32-bit and 64-bit versions are supported)<br></li><li><strong>Processador:</strong> Intel Core i3-3220 / AMD FX-4200 Quad-Core or better<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 650 / AMD Radeon HD 5770 or better with 2GB VRAM (Shader Model 5.0 compliant)<br></li><li><strong>DirectX:</strong> Versão 11<br></li><li><strong>Espaço no disco:</strong> Requer 320 MB de espaço livre<br></li><li><strong>Notas adicionais:</strong> Gamepad highly recommended</li></ul>"
            },
