                "reviews": [
                    {
                        "recommendationid": "38140217",
                        "author": {
                            "steamid": "76561197972499915",
                            "num_reviews": 1,
                            "playtime_forever": 1589,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 142,
                            "last_played": 1513042919
