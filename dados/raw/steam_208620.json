                "reviews": [
                    {
                        "recommendationid": "226644293",
                        "author": {
                            "steamid": "76561198119370185",
                            "num_reviews": 7,
                            "playtime_forever": 940,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 940,
                            "last_played": 1779993403
