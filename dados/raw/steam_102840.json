                "reviews": [
                    {
                        "recommendationid": "238118472",
                        "author": {
                            "steamid": "76561198193452031",
                            "num_reviews": 80,
                            "playtime_forever": 432,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 432,
                            "last_played": 1792442069
