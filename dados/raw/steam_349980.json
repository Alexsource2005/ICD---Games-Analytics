            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows XP / Vista / 7 / 8<br></li><li><strong>Processador:</strong> Intel 2.26 GHz Core 2 Duo or equivalent AMD processor<br></li><li><strong>Memória:</strong> 2 GB de RAM<br></li><li><strong>Placa gráfica:</strong> nVidia OpenGL 3.3 compatible / AMD HD7700 series (OpenGL 3.3 required) or higher<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 1 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX compatible Sound Card<br></li><li><strong>Notas adicionais:</strong> Local CO-OP is supported out of the box. For online CO-OP, you need to enable port forwarding for port 28327, UDP service type, on your router. A fast internet connection is highly recommended.</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 / 8<br></li><li><strong>Processador:</strong> Intel i5 Quad Core 3.4 GHz or equivalent AMD processor<br></li><li><strong>Memória:</strong> 4 MB de RAM<br></li><li><strong>Placa gráfica:</strong> nVidia GeForce GTX 560<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 1 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX compatible Sound Card<br></li><li><strong>Notas adicionais:</strong> Local CO-OP is supported out of the box. For online CO-OP, you need to enable port forwarding for port 28327, UDP service type, on your router. A fast internet connection is highly recommended.</li></ul>"
