                },
                "reviews": [
                    {
                        "recommendationid": "39170870",
                        "author": {
                            "steamid": "76561198066590240",
                            "num_reviews": 3404,
                            "playtime_forever": 72,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 72,
                            "last_played": 1515364095
