                "reviews": [
                    {
                        "recommendationid": "237900014",
                        "author": {
                            "steamid": "76561197979224744",
                            "num_reviews": 5,
                            "playtime_forever": 1121,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 1121,
                            "last_played": 1792206522
