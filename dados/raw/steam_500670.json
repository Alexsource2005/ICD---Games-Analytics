ttps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/500670/extras/0a87a366389d0d4d829b7534f012c9b2.poster.avif?t=1764621470\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/500670/extras/0a87a366389d0d4d829b7534f012c9b2.webm?t=1764621470\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/500670/extras/0a87a366389d0d4d829b7534f012c9b2.mp4?t=1764621470\" type=\"video/mp4\"></video></span>",
