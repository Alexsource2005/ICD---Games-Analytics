                "reviews": [
                    {
                        "recommendationid": "39451769",
                        "author": {
                            "steamid": "76561198110073193",
                            "num_reviews": 25,
                            "playtime_forever": 12,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 12,
                            "last_played": 1516336855
