                "reviews": [
                    {
                        "recommendationid": "204229147",
                        "author": {
                            "steamid": "76561197961034904",
                            "num_reviews": 78,
                            "playtime_forever": 185,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 185,
                            "last_played": 1757758805
