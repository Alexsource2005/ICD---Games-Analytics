                "reviews": [
                    {
                        "recommendationid": "42586049",
                        "author": {
                            "steamid": "76561197992924384",
                            "num_reviews": 6,
                            "playtime_forever": 63,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 63,
                            "last_played": 1529166018
                        },
                        "language": "english",
                        "review": "Original review -\nOkay, this is a game I loved on the ZX Spectrum. I have to agree with the previous reviewers. \nThe current control scheme feels alien! This can be great, but definable keys or at least an option of the original keymap would help somewhat! Writing on blackboards should also be \nsimpler as PC users have access to a keyboard. A good attempt spoiled only by the controls.\n\n*UPDATE* 14/06/18\nThe developers responded promptly! Thanks Roger, this is much more like it.\nThis is actually great, and a refreshing version of the original. I retract my previous words, this is definitely worth playing, and certainly worth the ticket price! If you are a fan of the original, this is a trip down memory lane. :)",
                        "timestamp_created": 1528490931,
                        "timestamp_updated": 1529008500,
                        "voted_up": true,
                        "votes_up": 30,
                        "votes_funny": 0,
                        "weighted_vote_score": 0.7707668542861938,
                        "comment_count": 0,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": false,
                        "developer_response": "Hi \nWe have now released an update which will allow  the control keys to be redefined.\nDefault (A,W,S,D) + classic (Q,A,O,P) Spectrum key options available. Fast movement mode has been added. + 2 new graphics options. Anti aliasing + texture filtering., plus more.  I hope this allows you to enjoy the game more.\n",
                        "timestamp_dev_responded": 1528999591,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
                ],
