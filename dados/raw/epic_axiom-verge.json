                "about": {
                    "image": {
                        "src": "https://cdn2.unrealengine.com/Diesel%2Fproduct%2Fpuffin%2FPrimaryPromo-2580x1450-0e73e709672c816a7803a575960d1a937c2caae0.jpg",
                        "_type": "Diesel Image"
