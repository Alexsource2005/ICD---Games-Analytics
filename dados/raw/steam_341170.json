source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/341170/extras/a40ea1e5caffef2b9b2c1b052a270ec1.mp4?t=1628613157\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/341170/extras/170b02491d75b023808e16fb76c92023.poster.avif?t=1628613157\" width=640 height=60 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/341170/extras/170b02491d75b023808e16fb76c92023.webm?t=1628613157\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/341170/extras/170b02491d75b023808e16fb76c92023.mp4?t=1628613157\" type=\"video/mp4\"></video></span>",
