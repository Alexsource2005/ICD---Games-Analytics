                "reviews": [
                    {
                        "recommendationid": "237395220",
                        "author": {
                            "steamid": "76561199224840606",
                            "num_reviews": 38,
                            "playtime_forever": 301,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 301,
                            "last_played": 1791625461
