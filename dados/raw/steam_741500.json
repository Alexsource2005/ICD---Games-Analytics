                "reviews": [
                    {
                        "recommendationid": "236456474",
                        "author": {
                            "steamid": "76561198026986702",
                            "num_reviews": 39,
                            "playtime_forever": 215,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 215,
                            "last_played": 1783148070
