                "reviews": [
                    {
                        "recommendationid": "41053294",
                        "author": {
                            "steamid": "76561198004098028",
                            "num_reviews": 45,
                            "playtime_forever": 266,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 250,
                            "last_played": 1522989545
