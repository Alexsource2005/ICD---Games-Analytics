                        "recommendationid": "14837472",
                        "author": {
                            "steamid": "76561198024968844",
                            "num_reviews": 21,
                            "playtime_forever": 5529,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 2059,
                            "last_played": 1592415521
