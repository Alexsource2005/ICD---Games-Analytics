                "reviews": [
                    {
                        "recommendationid": "234807435",
                        "author": {
                            "steamid": "76561198883691087",
                            "num_reviews": 10,
                            "playtime_forever": 599,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 599,
                            "last_played": 1788242371
