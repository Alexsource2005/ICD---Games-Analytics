            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7, .Net framework 3.5<br></li><li><strong>Processador:</strong> Multi-core CPU (Intel Core i5<br></li><li><strong>Memória:</strong> 1 GB de RAM<br></li><li><strong>Placa gráfica:</strong> 256 MB Pixel Shader 2.0 graphics card (nVidia GeForce FX 5600 or ATI Radeon X600)<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Placa de som:</strong> Soundblaster compatible soundcard</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows 7 or Windows 8, .Net framework 3.5<br></li><li><strong>Processador:</strong> Multi-core CPU (Intel Core i5 or i7, AMD Phenom II QUAD X4)<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> 1GB dedicated RAM, Pixel Shader 3.0 graphics card (AMD Radeon HD 5870, nVidia GTX 560)<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 3 GB de espaço livre<br></li><li><strong>Placa de som:</strong> Soundblaster compatible soundcard<br></li><li><strong>Notas adicionais:</strong> VRC USB adapter or controller, for hosting multiplayer sessions high upstream connection is recommended</li></ul>"
