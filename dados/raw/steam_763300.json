                "reviews": [
                    {
                        "recommendationid": "230667449",
                        "author": {
                            "steamid": "76561198367471798",
                            "num_reviews": 30096,
                            "playtime_forever": 610,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 610,
                            "last_played": 1784274508
