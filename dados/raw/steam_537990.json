r><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/537990/extras/3812ff1c5447cd45211d92048c3a239f.poster.avif?t=1692079145\" width=616 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/537990/extras/3812ff1c5447cd45211d92048c3a239f.webm?t=1692079145\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/537990/extras/3812ff1c5447cd45211d92048c3a239f.mp4?t=1692079145\" type=\"video/mp4\"></video></span>",
