            "dlc": [
                595830
            ],
            "detailed_description": "<p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/595440/extras/4f0fd5b8fbfbfcac088ca3cc7ae623a2.avif?t=1784075414\" width=628 height=312 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The invaders have taken over your computer. Stop them before they destroy your CPU.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>CPU Invaders</strong> lets you interact with your desktop while you play. Watch YouTube videos, chat with your friends, or continue using your computer as the game overlays your desktop.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Face enemies with unique abilities, battle bosses, and earn the highest score while defending your system.</p><h2 class=\"bb_tag\" >Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Gameplay overlaid on your desktop.</p></li><li><p class=\"bb_paragraph\" >Score system.</p></li><li><p class=\"bb_paragraph\" >Boss battles.</p></li><li><p class=\"bb_paragraph\" >Draggable interface.</p></li><li><p class=\"bb_paragraph\" >Enemies with unique abilities.</p></li><li><p class=\"bb_paragraph\" >Original 8-bit soundtrack by Frost Orb.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Note:</strong> Windows Aero must be enabled, otherwise the game background will appear as solid black.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/595440/extras/d7c0b2837849a64b0d63692853158232.avif?t=1784075414\" width=628 height=742 /></span></p>",
            "about_the_game": "<p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/595440/extras/4f0fd5b8fbfbfcac088ca3cc7ae623a2.avif?t=1784075414\" width=628 height=312 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The invaders have taken over your computer. Stop them before they destroy your CPU.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>CPU Invaders</strong> lets you interact with your desktop while you play. Watch YouTube videos, chat with your friends, or continue using your computer as the game overlays your desktop.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Face enemies with unique abilities, battle bosses, and earn the highest score while defending your system.</p><h2 class=\"bb_tag\" >Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Gameplay overlaid on your desktop.</p></li><li><p class=\"bb_paragraph\" >Score system.</p></li><li><p class=\"bb_paragraph\" >Boss battles.</p></li><li><p class=\"bb_paragraph\" >Draggable interface.</p></li><li><p class=\"bb_paragraph\" >Enemies with unique abilities.</p></li><li><p class=\"bb_paragraph\" >Original 8-bit soundtrack by Frost Orb.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Note:</strong> Windows Aero must be enabled, otherwise the game background will appear as solid black.</p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/595440/extras/d7c0b2837849a64b0d63692853158232.avif?t=1784075414\" width=628 height=742 /></span></p>",
            "short_description": "Invaders are living inside your computer. You shouldn't let that happen! Interact with your desktop while playing, watch Youtube videos, chat with your friends and more! CPU Invaders overlaps the game itself with your computer screen.",
            "supported_languages": "Inglês<strong>*</strong><br><strong>*</strong>idiomas com suporte total de áudio",
