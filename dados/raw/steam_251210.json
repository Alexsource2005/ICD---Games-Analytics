                "reviews": [
                    {
                        "recommendationid": "236111934",
                        "author": {
                            "steamid": "76561198001221753",
                            "num_reviews": 8,
                            "playtime_forever": 1085,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 957,
                            "last_played": 1791825447
