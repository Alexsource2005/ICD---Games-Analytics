036\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/303720/extras/b93823ddb376185e2503b60f2d249c1e.mp4?t=1786222036\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/303720/extras/cf5852b438e7bdd579953134380dcc59.poster.avif?t=1786222036\" width=482 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/303720/extras/cf5852b438e7bdd579953134380dcc59.webm?t=1786222036\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/303720/extras/cf5852b438e7bdd579953134380dcc59.mp4?t=1786222036\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/303720/extras/a425f02acc179b4dd4de2aeb98cdf64c.poster.avif?t=1786222036\" width=482 height=270 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/303720/extras/a425f02acc179b4dd4de2aeb98cdf64c.webm?t=1786222036\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/303720/extras/a425f02acc179b4dd4de2aeb98cdf64c.mp4?t=1786222036\" type=\"video/mp4\"></video></span>",
