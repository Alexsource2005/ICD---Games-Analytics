                "reviews": [
                    {
                        "recommendationid": "227059712",
                        "author": {
                            "steamid": "76561198040254248",
                            "num_reviews": 32,
                            "playtime_forever": 2395,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 2395,
                            "last_played": 1780454723
