                "reviews": [
                    {
                        "recommendationid": "36053415",
                        "author": {
                            "steamid": "76561198098436446",
                            "num_reviews": 11,
                            "playtime_forever": 22,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 22,
                            "last_played": 1509129286
                        },
                        "language": "english",
                        "review": "There's a lot of promise to this game but it's not there yet.\n\nPros:\n[list]\n[*]Smooth animations (tackles, running etc)\n[*]Up-to-date squads (just about)\n[/list]\n\nCons:\n[list]\n[*]Attacking line has no depth, backs plays are impossible\n[*]Players all feel the same (couldn't tell if I was controlling a back or a forward, eg Leicester's Veainu couldn't outpace a prop...)\n[*]Lineouts are hard, near impossible, to read when defending\n[/list]\n\nWith some updates this game could be pretty decent but I'm going to stick with RC3 for now.",
                        "timestamp_created": 1509130105,
                        "timestamp_updated": 1509130105,
                        "voted_up": false,
                        "votes_up": 26,
                        "votes_funny": 1,
                        "weighted_vote_score": 0.7130439281463623,
                        "comment_count": 4,
                        "steam_purchase": true,
                        "received_for_free": false,
                        "written_during_early_access": false,
                        "developer_response": "Hi Giblet.\nWe’ve recently released a pretty substantial update correcting some of the points you’re highlighting. This patch improves – among many other things – the overall players positioning during set plays, as well as the stamina system that has been reworked so you can really feel the difference between each position.\nWe invite you to try it out and give us your feedback on this dedicated thread: https://steamcommunity.com/app/627450/discussions/0/1500126447407268448/ \nThanks a lot for your time. :)",
                        "timestamp_dev_responded": 1513777872,
                        "primarily_steam_deck": false,
                        "refunded": true
                    }
                ],
