                "footer": {
                    "_type": "Diesel Product Footer",
                    "copy": "The Walking Dead © 2020 AMC Film Holdings LLC. All rights reserved. © 2020 Headup GmbH, all rights reserved. ClockStone and its logos are trademarks of ClockStone Software GmbH",
                    "privacyPolicyLink": {
