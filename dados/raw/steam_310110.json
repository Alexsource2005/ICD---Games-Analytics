            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> 64-bit Win XP, Vista, Win 7, Win 8<br></li><li><strong>Processador:</strong> Intel Core i5 at 2.6 GHz or AMD Phenom II X4 965 at 3.4 GHz<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 460 or AMD Radeon HD 5850 with 1GB VRAM<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 12 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX®-compatible</li></ul>",
                "recommended": "<strong>Recomendados:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> 64-bit Win XP, Vista, Win 7, Win 8<br></li><li><strong>Processador:</strong> Intel Core i5 at 3.2 GHz or AMD FX-8350 at 4.0 GHz<br></li><li><strong>Memória:</strong> 8 GB de RAM<br></li><li><strong>Placa gráfica:</strong> NVIDIA GeForce GTX 660 or AMD Radeon HD 7950 with 2GB VRAM<br></li><li><strong>DirectX:</strong> Versão 9.0c<br></li><li><strong>Rede:</strong> Ligação à Internet de banda larga<br></li><li><strong>Espaço no disco:</strong> Requer 12 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX®-compatible</li></ul>"
