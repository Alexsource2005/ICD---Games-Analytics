                "reviews": [
                    {
                        "recommendationid": "49328837",
                        "author": {
                            "steamid": "76561198042522212",
                            "num_reviews": 89,
                            "playtime_forever": 23,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 23,
                            "last_played": 1551590020
                        },
                        "language": "english",
                        "review": "Just a simple maze game, play a randomly generated maze and race against the clock to the end. I managed to get through a maze in 12 minutes and for the price of $5 I don't think it's worth it as it lacks content and gets boring really quickly. I guess it could be fun with friends but as I don't recommend this game I don't think that would ever happen. If you could catch this game in a sale I would try it however anything more then $1 I'd say your getting robbed.",
                        "timestamp_created": 1551588932,
                        "timestamp_updated": 1551590294,
                        "voted_up": false,
                        "votes_up": 12,
                        "votes_funny": 3,
                        "weighted_vote_score": 0.6435815095901489,
                        "comment_count": 3,
                        "steam_purchase": false,
                        "received_for_free": false,
                        "written_during_early_access": true,
                        "developer_response": "Hello, thx a lot for your review.\n\nThe main goal of EA - making a stable build with working multiplayer [and it's almost done].\nAs you can notice, all owner also getting Extra Mazes Pack DLC. This is a module for dustributon of new content.  [Mazes with different style and extra challenges, like traps/enemies, for example].\n\nAnd yes, default size is 31x31, but trust me, some ppl have a troubles even with this size. BUT, as early builds showed, 100x100 size is fine even for old PC. \n\nAnyway, all what were in old builds will be back soon or later.",
                        "timestamp_dev_responded": 1551731193,
                        "primarily_steam_deck": false,
                        "refunded": false
                    }
