                "reviews": [
                    {
                        "recommendationid": "239311039",
                        "author": {
                            "steamid": "76561198010439145",
                            "num_reviews": 24,
                            "playtime_forever": 820,
                            "playtime_last_two_weeks": 413,
                            "playtime_at_review": 820,
                            "last_played": 1793207257
