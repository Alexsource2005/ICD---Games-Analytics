            "pc_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo *:</strong> Windows: Vista/7/8<br></li><li><strong>Processador:</strong> AMD/Intel Dual-Core-processor running at 2.8 GHz (Intel Core i5-3570K or AMD Phenom II X3 720 or newer architectures)<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> DirectX 9.0x compatible ATI/NVIDIA graphics card with min. 1 GB VRAM (ATI Radeon HD4870 or NVIDIA GeForce GTX 660 equivalent or better)<br></li><li><strong>DirectX:</strong> Versão 9.0<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX 9.0c compatible sound card<br></li><li><strong>Notas adicionais:</strong> Mouse and keyboard</li></ul>"
            },
            "mac_requirements": {
                "minimum": "<strong>Mínimos:</strong><br><ul class=\"bb_ul\"><li><strong>Sistema Operativo:</strong> Mac OS X 10.8.2<br></li><li><strong>Processador:</strong> AMD/Intel Dual-Core-processor running at  3.2 GHz (Intel Core i3 or newer architectures)<br></li><li><strong>Memória:</strong> 4 GB de RAM<br></li><li><strong>Placa gráfica:</strong> DirectX 9.0x compatible ATI/NVIDIA graphics card with min. 1 GB VRAM (Radeon HD5670 equivalent or better)<br></li><li><strong>Espaço no disco:</strong> Requer 2 GB de espaço livre<br></li><li><strong>Placa de som:</strong> DirectX 9.0c compatible sound card<br></li><li><strong>Notas adicionais:</strong> The game does not support newer OSX versions than 10.14 (Mojave)</li></ul>"
            },
