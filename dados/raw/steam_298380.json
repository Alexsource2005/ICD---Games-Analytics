                "reviews": [
                    {
                        "recommendationid": "40373822",
                        "author": {
                            "steamid": "76561198066823191",
                            "num_reviews": 65,
                            "playtime_forever": 150,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 150,
                            "last_played": 1519520335
