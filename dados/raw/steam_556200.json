                        "recommendationid": "50413438",
                        "author": {
                            "steamid": "76561198053422627",
                            "num_reviews": 1375,
                            "playtime_forever": 38,
                            "playtime_last_two_weeks": 0,
                            "playtime_at_review": 38,
                            "last_played": 1556722763
